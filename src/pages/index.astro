---
import { ui } from '../data/i18n.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>iairu · Ondrej Špánik</title>
    <meta name="description" content="Ondrej Špánik: prompt engineer and 3D artist. Choose English or Slovenčina." />
    <link rel="canonical" href={`${Astro.site?.origin ?? ''}/en/`} />
    <link rel="alternate" hreflang="en" href={`${Astro.site?.origin ?? ''}/en/`} />
    <link rel="alternate" hreflang="sk" href={`${Astro.site?.origin ?? ''}/sk/`} />
    <link rel="alternate" hreflang="x-default" href={`${Astro.site?.origin ?? ''}/en/`} />
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
    <script is:inline>
      var l = 'en';
      try { l = localStorage.getItem('iairu-lang') || ((navigator.languages || [navigator.language]).some(function (x) { return /^(sk|cs)/i.test(x); }) ? 'sk' : 'en'); } catch (e) {}
      location.replace('/' + l + '/' + location.search + location.hash);
    </script>
    <style>body{font-family:system-ui,sans-serif;background:#0a0f14;color:#e9eff3;display:grid;place-items:center;min-height:100vh;margin:0}a{color:#3fe0d0;font-size:1.4rem;margin:0 1rem}</style>
  </head>
  <body><p><a href="/en/">English</a> <a href="/sk/">Slovenčina</a></p></body>
</html>
