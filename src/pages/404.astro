---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../data/i18n.js';
---
<Base lang="sk" title="404" path="" noindex solidHeader description="Stránka sa nenašla / Page not found">
  <section class="nf section">
    <div class="narrow center">
      <p class="code">404</p>
      <h1>{ui.sk.notFound.title}</h1>
      <p class="lead">{ui.sk.notFound.text}</p>
      <p class="lead en">{ui.en.notFound.text}</p>
      <p class="cta mid">
        <a class="btn" href="/sk/">{ui.sk.notFound.home} <Icon name="next" /></a>
        <a class="btn ghost" href="/en/">{ui.en.notFound.home}</a>
      </p>
    </div>
  </section>
</Base>
<style>
  .nf { padding-top: calc(var(--hdr) + 4rem); min-height: 70vh; display: grid; align-items: center; }
  .code { font-family: var(--display); font-size: clamp(6rem, 22vw, 14rem); line-height: 0.9; color: var(--red); margin: 0 0 0.2rem; }
  .en { font-size: 1rem; color: var(--mute); }
  .cta.mid { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; margin-top: 1.8rem; }
</style>
