---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { LANGS, ui } from '../../../data/i18n.js';
import { fields, interests, presets } from '../../../data/site.js';
import { projects, facet, repoSnapshotDate } from '../../../data/projects.js';
import { tr } from '../../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);

const fCount = facet(projects, (p) => p.fields);
const iCount = facet(projects, (p) => p.interests);
const lCount = facet(projects, (p) => p.language);
const langs = [...lCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const ui_ = {
  none: T('No project matches all of this.', 'Žiadny projekt nespĺňa všetko naraz.'),
  count: T('Showing {n} of {t} projects', 'Zobrazených {n} z {t} projektov'),
  langHide: T('Illustration, branding and 3D works have no programming language, so they are hidden while a language is selected.', 'Ilustrácie, branding a 3D práce nemajú programovací jazyk, preto sú pri zvolenom jazyku skryté.'),
  starsNote: T('Sorted by public GitHub stars; works that live outside GitHub have none, so they follow by date.', 'Zoradené podľa verejných hviezdičiek na GitHube; práce mimo GitHubu ich nemajú, preto nasledujú podľa dátumu.'),
  tryRemove: T('Try removing one of these:', 'Skús odstrániť niektorý z týchto filtrov:'),
  anyLang: T('Any language', 'Ľubovoľný jazyk'),
};
---
<Base lang={lang} path="projects/" title={ui[lang].nav.projects}
  description={T('Every project began as one specific problem. Ordered by GitHub stars, filterable by field, programming language and area of interest.', 'Každý projekt vznikol ako jeden konkrétny problém. Zoradené podľa hviezdičiek na GitHube, s filtrami podľa odboru, programovacieho jazyka a oblasti záujmu.')}
  crumbs={[{ label: ui[lang].nav.projects }]}>
  <section class="block head">
    <div class="wrap">
      <p class="eyebrow">{T('Challenges', 'Výzvy')}</p>
      <h1>{T('One problem at a time', 'Jeden problém naraz')}</h1>
      <p class="lead">{T('Each project began as one specific problem, and its field is simply what that problem needed, so work that crosses disciplines is normal here. Ordered by GitHub stars. The filters are a shortcut to the chapter you care about: a discipline, a language or the thing you are trying to get done.', 'Každý projekt vznikol ako jeden konkrétny problém a jeho odbor je jednoducho to, čo problém potreboval, takže práce naprieč odbormi sú tu bežné. Zoradené podľa hviezdičiek na GitHube. Filtre sú skratka ku kapitole, ktorá ťa zaujíma: odbor, jazyk alebo vec, ktorú chceš dosiahnuť.')}</p>
    </div>
  </section>

  <section class="wrap finder" id="filters" data-finder data-all={projects.length}
    data-s-none={ui_.none} data-s-count={ui_.count} data-s-lang-hide={ui_.langHide} data-s-stars={ui_.starsNote} data-s-try={ui_.tryRemove}>
    <form class="panel" aria-label={T('Filters', 'Filtre')} onsubmit="return false">
      <div class="row search">
        <label for="q" class="lab">{T('Search', 'Hľadať')}</label>
        <input id="q" type="search" autocomplete="off" placeholder={T('svelte, blender, logo, raspberry pi…', 'svelte, blender, logo, raspberry pi…')} data-q />
        <p class="hint">{T('Searches titles, descriptions, tools and languages.', 'Prehľadáva názvy, popisy, nástroje a jazyky.')}</p>
      </div>

      <fieldset class="row presets">
        <legend class="lab">{T('Start here', 'Začni tu')}</legend>
        <div class="chips">
          {presets.map((p) => <button type="button" class="chip preset" data-preset={JSON.stringify(p.set)}>{tr(p.label, lang)}</button>)}
        </div>
      </fieldset>

      <fieldset class="row">
        <legend class="lab">{T('Field of expertise', 'Odbor')}</legend>
        <p class="hint">{T('Which discipline the work belongs to. Choose several to see work that spans them.', 'Do ktorého odboru práca patrí. Vyber viac a uvidíš práce, ktoré ich spájajú.')}</p>
        <div class="chips">
          {Object.entries(fields).map(([k, f]) => (
            <label class={`chip c-${f.color}`} title={tr(f.hint, lang)}><input type="checkbox" name="field" value={k} /><span>{tr(f.label, lang)}</span><i data-count={`field:${k}`}>{fCount.get(k) ?? 0}</i></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="row">
        <legend class="lab">{T('Programming language', 'Programovací jazyk')}</legend>
        <p class="hint">{T('Pick the language you want to see code in.', 'Vyber jazyk, v ktorom chceš vidieť kód.')}</p>
        <div class="chips">
          {langs.map(([k, n]) => (
            <label class="chip lang"><input type="checkbox" name="lang" value={k} /><span>{k}</span><i data-count={`lang:${k}`}>{n}</i></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="row">
        <legend class="lab">{T('Area of interest', 'Oblasť záujmu')}</legend>
        <p class="hint">{T('What you want to get done. Hover a chip for a hint.', 'Čo chceš dosiahnuť. Po prejdení myšou nad možnosťou sa zobrazí nápoveda.')}</p>
        <div class="chips">
          {Object.entries(interests).map(([k, f]) => (
            <label class="chip" title={tr(f.hint, lang)}><input type="checkbox" name="interest" value={k} /><span>{tr(f.label, lang)}</span><i data-count={`interest:${k}`}>{iCount.get(k) ?? 0}</i></label>
          ))}
        </div>
      </fieldset>

      <div class="row bar">
        <label class="lab" for="sort">{T('Sort', 'Zoradiť')}</label>
        <select id="sort" data-sort>
          <option value="stars">{T('Most starred first', 'Najviac hviezdičiek')}</option>
          <option value="new">{T('Newest first', 'Najnovšie')}</option>
          <option value="old">{T('Oldest first', 'Najstaršie')}</option>
          <option value="name">{T('Name A–Z', 'Názov A–Z')}</option>
        </select>
        <button type="button" class="btn ghost sm" data-clear>{T('Clear all', 'Zrušiť všetko')}</button>
      </div>
    </form>

    <div class="results">
      <p class="status" role="status" aria-live="polite" data-status>{projects.length} {T('projects', 'projektov')}</p>
      <p class="remark" data-remark hidden></p>
      <div class="grid g3 list" data-list>
        {projects.map((p) => <ProjectCard p={p} lang={lang} filterable />)}
      </div>
      <div class="empty" data-empty hidden>
        <h2>{ui_.none}</h2>
        <p>{ui_.tryRemove}</p>
        <div class="chips" data-try></div>
      </div>
      <noscript><p class="remark">{T('Filters need JavaScript. All projects are listed above.', 'Filtre potrebujú JavaScript. Všetky projekty sú vypísané vyššie.')}</p></noscript>
      <p class="foot">{T('GitHub numbers snapshot', 'Stav GitHubu k dátumu')}: {repoSnapshotDate}. <a href="https://github.com/iairu?tab=repositories" rel="noopener">github.com/iairu ↗</a></p>
    </div>
  </section>
</Base>

<script>
  import { initFinder } from '../../../scripts/finder.ts';
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) initFinder(root);
</script>

<style>
  .head { padding-bottom: 1rem; }
  .finder { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: clamp(1.2rem, 3vw, 2.5rem); align-items: start; padding-bottom: 2rem; }
  .panel { position: sticky; top: calc(var(--hdr) + 12px); max-height: calc(100dvh - var(--hdr) - 24px); overflow: auto; background: var(--bg2); border: 1px solid var(--line); padding: 1rem 1.1rem; display: grid; gap: 1.1rem; border-top: 3px solid var(--cyan); }
  :global(html:not(.js)) .panel { display: none; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .lab { font: 500 .72rem var(--mono); text-transform: uppercase; letter-spacing: .14em; color: var(--copper); padding: 0; margin-bottom: .35rem; display: block; }
  .hint { font-size: .82rem; color: var(--soft); margin: 0 0 .55rem; line-height: 1.4; }
  input[type='search'], select { width: 100%; min-height: 44px; background: var(--bg); color: var(--ink); border: 1px solid var(--line2); padding: .6rem .8rem; font: 400 1rem var(--font); border-radius: 2px; }
  input[type='search']:focus-visible, select:focus-visible { outline-offset: 1px; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip { --c: var(--cyan); position: relative; display: inline-flex; align-items: center; gap: .45em; min-height: 36px; padding: .4em .7em; border: 1px solid var(--line2); background: var(--bg); color: var(--ink); font: 500 .8rem var(--mono); cursor: pointer; user-select: none; border-radius: 2px; }
  .chip i { font-style: normal; opacity: .6; font-size: .72rem; }
  .chip:hover { border-color: var(--c); }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip:has(input:checked), .chip.on { background: var(--c); color: var(--on-accent); border-color: var(--c); }
  .chip:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .chip.dim { opacity: .38; }
  .chip.preset { background: transparent; border-style: dashed; }
  .lang { --c: var(--amber); }
  .bar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .6rem; }
  .bar .lab { margin: 0; }
  .status { font: 500 .85rem var(--mono); margin: 0 0 .4rem; color: var(--ink); }
  .remark { font-size: .9rem; color: var(--soft); border-left: 3px solid var(--copper); padding: .3rem .8rem; margin: .2rem 0 1rem; }
  .list { margin-top: 1rem; }
  .empty { border: 1px dashed var(--line2); padding: 2rem; margin-top: 1rem; }
  .foot { margin-top: 2rem; font: 400 .76rem var(--mono); color: var(--soft); }
  @media (max-width: 900px) {
    .finder { grid-template-columns: 1fr; }
    .panel { position: static; max-height: none; }
  }
</style>
