---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { LANGS, ui } from '../../../data/i18n.js';
import { fields, interests } from '../../../data/site.js';
import { projects, repoSnapshotDate } from '../../../data/projects.js';
import { tr, lhref, resolveHref, isExternal } from '../../../data/util.js';

export const getStaticPaths = () => LANGS.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.id }, props: { p } })));
const { lang } = Astro.params;
const { p } = Astro.props;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const title = tr(p.title, lang);
const links = [...(p.repoUrl ? [{ label: 'GitHub', href: p.repoUrl, primary: !p.links.length }] : []), ...p.links.filter((l) => !l.only || l.only === lang).map((l) => ({ label: tr(l.label, lang), href: resolveHref(l.href, lang) }))];
const related = projects.filter((o) => o.id !== p.id && o.fields.some((f) => p.fields.includes(f))).sort((a, b) => b.fields.filter((f) => p.fields.includes(f)).length - a.fields.filter((f) => p.fields.includes(f)).length || b.stars - a.stars).slice(0, 3);
const idx = projects.findIndex((o) => o.id === p.id);
const color = fields[p.fields[0]].color;
const gallery = p.gallery ?? [];
---
<Base lang={lang} path={`projects/${p.id}/`} title={title} description={tr(p.desc, lang)} image={p.image ?? '/img/nightjar-gift.png'}
  crumbs={[{ label: ui[lang].nav.projects, href: lhref(lang, 'projects/') }, { label: title }]}>
  <article class={`block c-${color}`}>
    <div class="wrap">
      <header class="top">
        <div>
          <p class="eyebrow">{tr(p.tag, lang)}</p>
          <h1>{title}</h1>
          <p class="lead">{tr(p.desc, lang)}</p>
          {p.long && <p class="long">{tr(p.long, lang)}</p>}
          <div class="actions">
            {links.map((l) => <a class={`btn ${l.primary || l === links[0] ? 'primary' : 'ghost'}`} href={l.href} {...(isExternal(l.href) ? { rel: 'noopener', target: '_blank' } : {})}>{l.label}{isExternal(l.href) ? ' ↗' : ''}</a>)}
          </div>
        </div>
        {(p.image || p.logo) && (
          <div class="hero-img" style={p.bg ? `background-image:url(${p.bg})` : undefined}>
            {p.logo ? <img class="logo" src={p.logo} alt={title} /> : <img src={p.image} alt="" />}
          </div>
        )}
      </header>

      <dl class="facts">
        <div><dt>{T('Fields', 'Odbory')}</dt><dd class="tags">{p.fields.map((f) => <a class={`tag c-${fields[f].color}`} href={lhref(lang, `projects/?field=${f}`)}>{tr(fields[f].label, lang)}</a>)}</dd></div>
        <div><dt>{T('Interests', 'Záujmy')}</dt><dd class="tags">{p.interests.map((i) => <a class="tag" href={lhref(lang, `projects/?interest=${i}`)}>{tr(interests[i].label, lang)}</a>)}</dd></div>
        {p.language && <div><dt>{T('Language', 'Jazyk')}</dt><dd class="tags"><a class="tag lang c-amber" href={lhref(lang, `projects/?lang=${encodeURIComponent(p.language)}`)}>{p.language}</a></dd></div>}
        {p.tools && <div><dt>{T('Tools', 'Nástroje')}</dt><dd class="tags">{p.tools.map((t) => <span class="tag">{t}</span>)}</dd></div>}
        <div><dt>{T('Year', 'Rok')}</dt><dd>{p.year}{p.updated ? ` · ${T('last push', 'posledný push')} ${p.updated}` : ''}</dd></div>
        {p.repoUrl && <div><dt>GitHub</dt><dd><span class="star">★ {p.stars}</span> <small>({repoSnapshotDate})</small></dd></div>}
      </dl>

      {gallery.length > 0 && (
        <section aria-label={T('Gallery', 'Galéria')}>
          <h2>{T('Gallery', 'Galéria')}</h2>
          <ul class="gal">
            {gallery.map((g, i) => <li><a href={g} target="_blank" rel="noopener"><img src={p.thumbs?.[i] ?? g} alt={`${title} ${i + 1}`} loading="lazy" /></a></li>)}
          </ul>
          <p class="note">{T('Images open full size in a new tab.', 'Obrázky sa otvoria v plnej veľkosti v novej karte.')}</p>
        </section>
      )}

      <nav class="pn" aria-label={T('Neighbouring projects', 'Susedné projekty')}>
        {idx > 0 ? <a href={lhref(lang, `projects/${projects[idx - 1].id}/`)}>← {tr(projects[idx - 1].title, lang)}</a> : <span />}
        {idx < projects.length - 1 && <a href={lhref(lang, `projects/${projects[idx + 1].id}/`)}>{tr(projects[idx + 1].title, lang)} →</a>}
      </nav>
    </div>
  </article>

  <section class="block band">
    <div class="wrap">
      <h2>{T('Related work', 'Súvisiaca práca')}</h2>
      <div class="grid g3">{related.map((o) => <ProjectCard p={o} lang={lang} compact />)}</div>
      <p class="more"><a class="btn ghost" href={lhref(lang, 'projects/')}>{T('All projects', 'Všetky projekty')}</a></p>
    </div>
  </section>
</Base>
<style>
  .top { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); align-items: center; }
  .eyebrow { color: var(--c); }
  .long { color: var(--ink); max-width: 60ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; }
  .hero-img { border: 1px solid var(--line); background: var(--bg3) center/cover; overflow: hidden; display: grid; place-items: center; min-height: 200px; box-shadow: var(--shadow); border-top: 3px solid var(--c); }
  .hero-img img { width: 100%; height: auto; }
  .hero-img img.logo { width: 60%; max-height: 320px; padding: 2rem 0; filter: drop-shadow(0 6px 18px rgb(0 0 0 / .35)); }
  .facts { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin: clamp(2rem, 5vw, 3.5rem) 0; padding: 1.2rem 0; border-block: 1px solid var(--line); }
  dt { font: 500 .7rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--copper); margin-bottom: .4rem; }
  dd { margin: 0; } a.tag { text-decoration: none; } a.tag:hover { background: color-mix(in srgb, var(--c, var(--soft)) 18%, transparent); }
  .gal { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .gal a { display: block; border: 1px solid var(--line); background: var(--bg3); } .gal img { width: 100%; height: auto; transition: opacity .2s; } .gal a:hover img { opacity: .85; }
  .note { font: 400 .76rem var(--mono); color: var(--soft); margin-top: .8rem; }
  .pn { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; font: 500 .85rem var(--mono); flex-wrap: wrap; }
  .more { margin-top: 1.6rem; }
</style>
