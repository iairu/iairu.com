---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import LogoWall from '../../components/LogoWall.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import YouTube from '../../components/YouTube.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, ui, tr } from '../../data/i18n.js';
import { booking, links } from '../../data/site.js';
import { lhref } from '../../data/util.js';
import { home } from '../../data/content.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = ui[lang];
const h = home;
---
<Base lang={lang} path="">
  <Hero
    eyebrow={tr(h.hero.eyebrow, lang)}
    heading={tr(h.hero.heading, lang)}
    lead={tr(h.hero.lead, lang)}
    bg={h.hero.bg}
    flare={h.hero.flare}
  >
    <div class="cta" slot="cta">
      <a class="btn" href="#booking">{T.bookNow} <Icon name="next" /></a>
      <a class="btn ghost" href="#show">{tr({ sk: 'Pozrieť show', en: 'See the show' }, lang)}</a>
    </div>
  </Hero>

  <Stats data={h.stats} lang={lang} />

  <LogoWall title={tr(h.referencesTitle, lang)} items={h.references} />

  <!-- About -->
  <section class="section about" id="show" aria-labelledby="about-h">
    <div class="wrap-wide split">
      <figure class="photo" data-reveal>
        <img src={h.about.image} alt={tr(h.about.heading, lang)} loading="lazy" width="900" height="1100" data-zoom />
      </figure>
      <div class="text" data-reveal>
        <p class="eyebrow">{tr(h.about.label, lang)}</p>
        <h2 id="about-h">{tr(h.about.heading, lang)}</h2>
        {tr(h.about.body, lang).split('\n\n').map((p) => <p class="body" set:html={p} />)}
        <div class="cta">
          <a class="btn ghost" href={links.instagram} rel="noopener" target="_blank"><Icon name="instagram" /> Instagram</a>
          <a class="btn ghost" href={links.youtube} rel="noopener" target="_blank"><Icon name="youtube" /> YouTube</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Two show formats -->
  <section class="section band shows" aria-labelledby="shows-h">
    <div class="wrap-wide">
      <div class="sec-head center">
        <p class="eyebrow">{tr(h.shows.label, lang)}</p>
        <h2 id="shows-h">{tr(h.shows.heading, lang)}</h2>
      </div>
      <div class="two">
        {h.shows.items.map((s, i) => (
          <article class="show-card" data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{tr(s.name, lang)}</h3>
            {tr(s.body, lang).split('\n\n').map((p) => <p set:html={p} />)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="quote-band" aria-hidden="false">
    <div class="narrow center">
      <p class="quote">{tr(h.quote, lang)}</p>
    </div>
  </section>

  <Gallery title={tr(h.galleryTitle, lang)} items={h.gallery} lang={lang} hint={T.galleryHint} />

  <!-- Video -->
  <section class="section band video" aria-labelledby="video-h">
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow">{tr(h.video.label, lang)}</p>
        <h2 id="video-h">{tr(h.video.heading, lang)}</h2>
      </div>
      <div data-reveal>
        <YouTube id={h.video.youtubeId} title={tr(h.video.heading, lang)} />
      </div>
    </div>
  </section>

  <Testimonials title={tr(h.testimonialsTitle, lang)} list={tr(h.testimonials, lang)} />

  <!-- Booking -->
  <section class="section booking" id="booking" aria-labelledby="book-h">
    <div class="narrow center" data-reveal>
      <p class="eyebrow">{tr(h.booking.label, lang)}</p>
      <h2 id="book-h">{tr(h.booking.heading, lang)}</h2>
      <p class="lead">{tr(h.booking.lead, lang)}</p>
      <div class="contacts">
        <a class="contact" href={`mailto:${booking.email}`}><Icon name="mail" size="1.3rem" /><span>{booking.email}</span></a>
        <a class="contact" href={`tel:${booking.phoneHref}`}><Icon name="phone" size="1.3rem" /><span>{booking.phone}</span></a>
      </div>
      <div class="cta mid"><a class="btn" href={`mailto:${booking.email}`}>{T.bookNow} <Icon name="next" /></a></div>
    </div>
  </section>
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .photo { margin: 0; overflow: hidden; border: 1px solid var(--line); }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; cursor: zoom-in; transition: transform 0.6s; }
  .photo:hover img { transform: scale(1.04); }
  .about .body { color: var(--soft); font-weight: 300; }
  .about .cta { margin-top: 1.6rem; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 2rem); }
  .show-card { padding: clamp(1.6rem, 3vw, 2.4rem); background: var(--bg3); border: 1px solid var(--line); border-top: 2px solid var(--gold); position: relative; }
  .show-card .idx { font-family: var(--serif); font-size: 1rem; color: var(--gold); letter-spacing: 0.1em; }
  .show-card h3 { margin: 0.2rem 0 0.8rem; }
  .show-card p { color: var(--soft); font-weight: 300; font-size: 0.98rem; }

  .quote-band { padding-block: clamp(3.5rem, 8vw, 7rem); background: linear-gradient(180deg, var(--bg), var(--bg2)); border-bottom: 1px solid var(--line); }
  .quote { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(1.6rem, 1.1rem + 2.6vw, 3rem); line-height: 1.25; color: var(--ink); margin: 0; }

  .video .wrap { max-width: 980px; }

  .booking { background: radial-gradient(130% 100% at 50% 0%, color-mix(in srgb, var(--gold) 7%, transparent), transparent 60%), var(--bg); border-top: 1px solid var(--line); }
  .contacts { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.2rem; margin: 2rem 0 0.4rem; }
  .contact { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); font-size: 1.05rem; }
  .contact:hover { color: var(--gold); }
  .contact .icon { color: var(--gold); }
  .cta.mid { justify-content: center; margin-top: 1.8rem; }

  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } .two { grid-template-columns: 1fr; } }
</style>
