---
import Base from '../../layouts/Base.astro';
import Viewer from '../../components/Viewer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { LANGS } from '../../data/i18n.js';
import { fields, person, links } from '../../data/site.js';
import { projects, facet, byId } from '../../data/projects.js';
import { tr, lhref } from '../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const top = projects.slice(0, 6);
const art = ['zrada', 'zenit', 'comics', 'ghast'].map((i) => byId[i]);
const counts = facet(projects, (p) => p.fields);
const pipeline = [
  { c: 'violet', t: T('Prompt', 'Prompt'), d: T('Direct AI like an instrument: specify, test, iterate, and keep the human in charge of the result.', 'Riadiť AI ako nástroj: zadať, otestovať, iterovať a nechať ľudí zodpovedných za výsledok.') },
  { c: 'cyan', t: T('Code', 'Kód'), d: T('Classic programming: C, Python, JavaScript, Svelte, Astro. Software that is read, tested and kept.', 'Klasické programovanie: C, Python, JavaScript, Svelte, Astro. Softvér, ktorý sa číta, testuje a udržiava.') },
  { c: 'pink', t: T('Model', 'Model'), d: T('Blender and CAD: shape something in 3D until it can be measured, rendered or cut.', 'Blender a CAD: vytvarovať niečo v 3D, kým sa to nedá zmerať, vyrenderovať alebo vyrezať.') },
  { c: 'copper', t: T('Circuit', 'Obvod'), d: T('Schematics, boards and firmware, or better no firmware: electronics that fit inside the shape.', 'Schémy, dosky a firmvér, alebo ešte lepšie žiadny firmvér: elektronika, ktorá sa zmestí do tvaru.') },
  { c: 'lime', t: T('Object', 'Objekt'), d: T('CNC, wood, solder. The thing sits on a desk, you press a button and it works.', 'CNC, drevo, spájka. Vec stojí na stole, stlačíš tlačidlo a funguje.') },
];
---
<Base lang={lang} path="" description={T('Ondrej "iairu" Špánik: prompt engineer and maker who takes on one challenge at a time, from code and circuits to 3D and illustration.', 'Ondrej „iairu“ Špánik: prompt inžinier a 3D umelec, ktorý mení kód, elektroniku a 3D modely na skutočné fungujúce objekty.')}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="copy">
        <h1 class="tilt" data-tilt>
          {lang === 'sk' ? <>Výzva si vyberie <span class="a">remeslo</span>, ja ho <span class="b">dotiahnem</span>.</> : <>The challenge picks the <span class="a">craft</span>. I <span class="b">finish</span> it.</>}
        </h1>
        <p class=”lead calm”>{T('I am Ondrej “iairu” Špánik. I take on one challenge at a time and go deep until it works, so my focus moves with the problem: code one month, a circuit or a 3D model the next, a prompt-driven build after that.', 'Som Ondrej „iairu” Špánik. Riešim jednu výzvu naraz a idem do hĺbky, kým to nefunguje, takže moje zameranie sa hýbe s problémom: jeden mesiac kód, ďalší obvod alebo 3D model, potom vývoj riadený promptami.')}</p>
        <div class="cta">
          <a class="btn primary live" href={lhref(lang, 'projects/')}>{T('See the challenges', 'Pozrieť výzvy')} <Icon name="next" /></a>
          <a class="btn ghost live twin" href={lhref(lang, 'art/')}>{T('See the art & 3D', 'Pozrieť umenie a 3D')} <Icon name="next" /></a>
        </div>
      </div>
      <Viewer lang={lang} />
    </div>
  </section>

  <section class="block pcb" aria-labelledby="bridge">
    <svg class="bus" viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <g stroke="var(--cobalt)"><path d="M0 120h140l40 40v130l30 30h70"/><path d="M0 170h90l30 30v70l50 50h110"/><path d="M0 470h220l30-30h60"/><circle cx="284" cy="320" r="5"/><circle cx="374" cy="320" r="5"/><circle cx="314" cy="440" r="5"/>
      <path d="M1200 90h-170l-40 40v150l-40 40h-60"/><path d="M1200 150h-120l-30 30v100l-40 40h-110"/><path d="M1200 480h-260l-40-40h-40"/><circle cx="886" cy="320" r="5"/><circle cx="896" cy="320" r="5"/><circle cx="856" cy="440" r="5"/></g>
      <g stroke="var(--blue)"><path d="M300 0v40l30 30h540l30-30V0"/><path d="M600 70v40"/><circle cx="600" cy="114" r="5"/><circle cx="180" cy="160" r="4" fill="var(--blue)" stroke="none"/><circle cx="990" cy="130" r="4" fill="var(--blue)" stroke="none"/></g>
    </svg>
    <div class="wrap">
      <div class="sec-head">
        <h2 id="bridge">{T('One method, whichever tools the problem needs', 'Jedna metóda, nech problém vyžaduje akékoľvek nástroje')}</h2>
        <p>{T('No project uses every step. The challenge decides where the work goes deep; the steps are just the order I check them in.', 'Žiadny projekt nepoužije všetky kroky. Výzva určí, kde sa ide do hĺbky; kroky sú len poradie, v akom ich prechádzam.')}</p>
      </div>
      <ol class="pipe">
        {pipeline.map((s) => <li class={`c-${s.c}`}><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="block band lit corner" aria-labelledby="top">
    <img class="corner-art" src="/img/bio.png" alt="" width="700" height="287" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="sec-head">
        <h2 id="top">{T('What people on GitHub liked most', 'Čo sa ľuďom na GitHube páčilo najviac')}</h2>
        <p>{T('The full list is ordered the same way, and you can filter it.', 'Celý zoznam je zoradený rovnako a dá sa filtrovať.')}</p>
      </div>
      <div class="grid g3">{top.map((p) => <ProjectCard p={p} lang={lang} />)}</div>
      <p class="more"><a class="btn ghost" href={lhref(lang, 'projects/')}>{T(`All ${projects.length} projects`, `Všetkých ${projects.length} projektov`)}</a></p>
    </div>
  </section>

  <section class="block" aria-labelledby="fields">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="fields">{T('Follow the challenge you care about', 'Sleduj výzvu, ktorá ťa zaujíma')}</h2>
        <p>{T('Every project was one specific problem, and its field is just what the problem needed. Open a field to see that chapter, or combine two there to see where they met.', 'Každý projekt bol jeden konkrétny problém a jeho odbor je len to, čo problém potreboval. Otvor odbor a uvidíš danú kapitolu, alebo ich tam skombinuj a uvidíš, kde sa stretli.')}</p>
      </div>
      <ul class="fields">
        {Object.entries(fields).map(([k, f]) => (
          <li class={`c-${f.color}`}><a href={lhref(lang, `projects/?field=${k}`)}><h3>{tr(f.label, lang)}</h3><p>{tr(f.hint, lang)}</p><span class="cnt">{counts.get(k) ?? 0} {T('projects', 'projektov')}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block nj" aria-labelledby="nj">
    <div class="wrap split">
      <div>
        <h2 id="nj">NightJar.Gift: {T('a wooden nightjar that sings', 'drevený lelek, ktorý spieva')}</h2>
        <p class="lead">{T('A 3D model became CNC toolpaths, then two halves of beech with a circuit that has no microcontroller and no firmware. Hold the button on its back and it churrs; let go and it sleeps.', '3D model sa stal dráhami pre CNC, potom dvoma polovicami buku s obvodom bez mikrokontroléra a bez firmvéru. Podrž tlačidlo na jeho chrbte a vrčí; pusti a zaspí.')}</p>
        <p class="temp" role="note"><b>{T('Temporary model.', 'Dočasný model.')}</b> {T('The 3D bird above is a stand-in, not the final version of the model.', 'Trojrozmerný lelok vyššie je zástupný, nie konečná verzia modelu.')}</p>
        <div class="cta">
          <a class="btn primary" href={lhref(lang, 'projects/nightjar-gift/')}>{T('Read the story', 'Prečítať príbeh')}</a>
          <a class="btn ghost" href={links.nightjar} rel="noopener" target="_blank">nightjar.gift <Icon name="ext" /></a>
        </div>
      </div>
      <img class="lel-img" src="/img/nightjar-gift.png" alt={T('NightJar.Gift promo picture', 'Promo obrázok NightJar.Gift')} loading="lazy" width="1200" height="630" data-zoom />
    </div>
  </section>

  <section class="block band" aria-labelledby="art">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="art">{T('Art that had to solve something', 'Umenie, ktoré malo niečo vyriešiť')}</h2>
        <p>{T('A logo that must hold up, a story told in letters, a character that has to read at a glance. The graphic design school came before the code, and it still shapes how I build.', 'Logo, ktoré musí obstáť, príbeh vyrozprávaný písmenami, postava, ktorá sa musí čítať na prvý pohľad. Škola grafického dizajnu prišla pred kódom a stále formuje to, ako stavam.')}</p>
      </div>
      <div class="grid g3 art4">{art.map((p) => <ProjectCard p={p} lang={lang} compact />)}</div>
      <p class="more"><a class="btn ghost" href={lhref(lang, 'art/')}>{T('The whole art side', 'Celá umelecká strana')}</a></p>
    </div>
  </section>

  <section class="block contact" aria-labelledby="hi">
    <div class="wrap narrow center">
      <h2 id="hi">{T('Have a thing that should exist?', 'Máš vec, ktorá by mala existovať?')}</h2>
      <p class="lead">{T('Tell me what it should do. I will tell you honestly which parts are code, which are copper and which are wood.', 'Povedz mi, čo má robiť. Poviem ti úprimne, ktoré časti budú kód, ktoré meď a ktoré drevo.')}</p>
      <div class="cta mid"><a class="btn primary" href={`mailto:${person.email}`}>{person.email}</a><a class="btn ghost" href={lhref(lang, 'contact/')}>{T('More ways to reach me', 'Ďalšie spôsoby kontaktu')}</a></div>
    </div>
  </section>
</Base>

<script>
  // Tilt the hero headline slightly toward the pointer on desktop. Never runs with reduced motion.
  const h = document.querySelector<HTMLElement>('[data-tilt]');
  const hero = h?.closest<HTMLElement>('.hero');
  if (h && hero && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const MAX = 6;
    let raf = 0;
    const clamp = (v: number) => Math.max(-1, Math.min(1, v));
    // x, y in -1..1
    const set = (x: number, y: number) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        h.style.setProperty('--ry', `${(x * MAX).toFixed(2)}deg`);
        h.style.setProperty('--rx', `${(-y * MAX * 0.7).toFixed(2)}deg`);
        h.classList.add('on');
      });
    };
    const reset = () => { cancelAnimationFrame(raf); h.style.setProperty('--rx', '0deg'); h.style.setProperty('--ry', '0deg'); h.classList.remove('on'); };

    if (matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = h.getBoundingClientRect();
        set(clamp((e.clientX - (r.left + r.width / 2)) / (r.width / 2)), clamp((e.clientY - (r.top + r.height / 2)) / (r.height / 1.2)));
      });
      hero.addEventListener('pointerleave', reset);
    }
  }
</script>

<style>
  .hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 6vw, 5rem); position: relative; overflow: hidden; }
  .hero-grid { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  /* the headline carries both halves of the work: "craft" is drawn as a cyan wireframe (outline only,
     narrow cut), "finish" is solid copper and gets soldered: a trace runs under it into a pad */
  h1 .a { color: transparent; -webkit-text-stroke: max(1.5px, .028em) var(--blue); font-variation-settings: 'wdth' 75; letter-spacing: -.01em; padding-right: .04em; }
  h1 .b { color: var(--cobalt); position: relative; }
  h1 .b::before { content: ''; position: absolute; left: .02em; right: .34em; bottom: -.06em; height: .07em; background: currentColor; transform-origin: left; animation: trace .9s .35s cubic-bezier(.16, 1, .3, 1) both; }
  h1 .b::after { content: ''; position: absolute; right: .06em; bottom: -.17em; width: .29em; height: .29em; border: .07em solid currentColor; border-radius: 50%; background: var(--bg); box-sizing: border-box; animation: pad .4s 1.1s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes trace { from { transform: scaleX(0); } }
  @keyframes pad { from { transform: scale(0); } }
  @supports not (-webkit-text-stroke: 1px black) { h1 .a { color: var(--blue); } }
  /* headline tilts toward the pointer; the two coloured words float a little above the sheet */
  .tilt { --rx: 0deg; --ry: 0deg; transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry)); transform-style: preserve-3d; transition: transform .6s cubic-bezier(.16, 1, .3, 1); will-change: transform; }
  .tilt .a, .tilt .b { display: inline-block; transform: translateZ(42px); transition: text-shadow .6s cubic-bezier(.16, 1, .3, 1); }
  .tilt.on .b { text-shadow: calc(var(--ry) * -.5) calc(var(--rx) * .5) 18px rgb(0 0 0 / .35); }
  .hero .lead { margin-bottom: 1.6rem; }
  /* the intro reads as body copy so the headline and the buttons lead the hero */
  .lead.calm { font-size: 1.05rem; line-height: 1.6; max-width: 56ch; color: var(--soft); }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; }
  /* the main call to action: a signal pulse keeps running around it, like current along a trace */
  @property --sweep { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .btn.live { position: relative; isolation: isolate; min-height: 52px; padding: .9em 1.4em; font-size: 1.02rem; }
  .btn.live::before { content: ''; position: absolute; inset: -4px; z-index: -1; border-radius: 3px; padding: 2px;
    background: conic-gradient(from var(--sweep), transparent 0 70%, var(--blue) 82%, var(--ink) 88%, transparent 92%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); animation: sweep 2.4s linear infinite; }
  .btn.live .icon { transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
  .btn.live:hover .icon { transform: translateX(4px); }
  @keyframes sweep { to { --sweep: 360deg; } }
  /* the secondary button carries the same signal in copper, half a turn behind, so the two trade it back and forth */
  .btn.live.twin::before { background: conic-gradient(from var(--sweep), transparent 0 70%, var(--cobalt) 82%, var(--ink) 88%, transparent 92%); animation-delay: -1.2s; } .cta.mid { justify-content: center; margin-top: 1.4rem; }
  /* a routed board behind the method: copper buses come in from both edges and land on pads around the strip */
  .pcb { isolation: isolate; overflow: hidden; }
  .pcb .bus { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: .12; }
  .pipe { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); }
  .pipe li { --c: var(--blue); padding: 1.4rem 1.2rem 1.5rem; border-right: 1px solid var(--line); position: relative; background: var(--bg2); }
  .pipe li:last-child { border-right: 0; }
  .pipe li + li::before { content: ''; position: absolute; left: -7px; top: 1.6rem; width: 12px; height: 12px; border: 1px solid var(--line2); border-left: 0; border-bottom: 0; background: var(--bg2); transform: rotate(45deg); z-index: 1; }
  .pipe h3 { margin: 0 0 .5rem; color: var(--c); } .pipe p { margin: 0; font-size: .92rem; color: var(--soft); line-height: 1.5; }
  .more { margin-top: 1.6rem; }
  /* the most-starred band is lit from one corner: a low amber glow off the top left, the far side sinking toward black */
  .band.lit { background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--yellow) 7%, transparent), transparent 60%),
    radial-gradient(90% 80% at 100% 100%, color-mix(in srgb, var(--bg) 70%, transparent), transparent 70%), var(--bg2); }
  /* the desk illustration (the workbench itself) leans on the right rail and fades up into the band */
  .band.corner { isolation: isolate; overflow: hidden; }
  .corner-art { position: absolute; right: max(6px, calc((100% - min(100% - 2 * var(--gutter), var(--maxw))) / 2 - clamp(8px, 2.5vw, 32px))); bottom: 0; z-index: -1; pointer-events: none; display: block;
    width: min(46vw, 560px); height: auto; opacity: .42; -webkit-mask-image: linear-gradient(to top left, #000 30%, transparent 78%); mask-image: linear-gradient(to top left, #000 30%, transparent 78%); }
  :global(:root[data-theme='dark']) .corner-art { filter: invert(.9) hue-rotate(180deg); }
  .fields { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); column-gap: clamp(1.5rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .fields li { --c: var(--blue); border-bottom: 1px solid var(--line); }
  .fields a { display: grid; grid-template-columns: 1fr auto; gap: .2rem 1.5rem; align-items: baseline; padding: 1.1rem 0 1.2rem; text-decoration: none; color: var(--ink); }
  .fields h3 { margin: 0; color: var(--c); transition: color .15s; } .fields p { grid-column: 1; margin: 0; color: var(--soft); font-size: .95rem; }
  .fields .cnt { grid-row: 1; grid-column: 2; font: 500 .8rem var(--mono); font-variant-numeric: tabular-nums; color: var(--soft); white-space: nowrap; }
  .fields a:hover h3 { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .nj { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--cobalt) 7%, transparent)); }
  .lel-img { border: 1px solid var(--line); width: 100%; height: auto; }
  .temp { border: 1px dashed var(--cobalt); padding: .6rem .9rem; font-size: .9rem; line-height: 1.5; color: var(--soft); max-width: 52ch; margin-bottom: 1.4rem; } .temp b { color: var(--cobalt); font-weight: 600; }
  .center { text-align: center; } .center .lead { margin-inline: auto; }
  .contact { border-top: 1px solid var(--line); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .pipe { grid-template-columns: 1fr; } .pipe li { border-right: 0; border-bottom: 1px solid var(--line); } .pipe li:last-child { border-bottom: 0; } .pipe li + li::before { left: 1.2rem; top: -7px; transform: rotate(135deg); } }
</style>
