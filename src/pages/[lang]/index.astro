---
import Base from '../../layouts/Base.astro';
import CardFan from '../../components/CardFan.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { LANGS } from '../../data/i18n.js';
import { fields, person, links } from '../../data/site.js';
import { projects, facet, byId } from '../../data/projects.js';
import { tr, lhref } from '../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const top = projects.slice(0, 6);
const art = ['zrada', 'zenit', 'comics', 'ghast'].map((i) => byId[i]);
const counts = facet(projects, (p) => p.fields);
---
<Base lang={lang} path="" description={T('Ondrej "iairu" Špánik: prompt engineer and maker who takes on one challenge at a time, from code and circuits to 3D and illustration.', 'Ondrej „iairu“ Špánik: prompt inžinier a 3D umelec, ktorý mení kód, elektroniku a 3D modely na skutočné fungujúce objekty.')}>
  <section class="hero">
    <div class="wrap"><h1>{T('Total geek.', 'Totálny geek.')}</h1></div>
    <CardFan lang={lang} />
  </section>

  <section class="block band lit corner" aria-labelledby="top">
    <img class="corner-art" src="/img/bio.png" alt="" width="700" height="287" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="sec-head">
        <h2 id="top">{T('What people on GitHub liked most', 'Čo sa ľuďom na GitHube páčilo najviac')}</h2>
        <p>{T('The full list is ordered the same way, and you can filter it.', 'Celý zoznam je zoradený rovnako a dá sa filtrovať.')}</p>
      </div>
      <div class="grid g3">{top.map((p) => <ProjectCard p={p} lang={lang} />)}</div>
      <p class="more"><a class="btn ghost" href={lhref(lang, 'projects/')}>{T(`All ${projects.length} projects`, `Všetkých ${projects.length} projektov`)}</a></p>
    </div>
  </section>

  <section class="block" aria-labelledby="fields">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="fields">{T('Follow the challenge you care about', 'Sleduj výzvu, ktorá ťa zaujíma')}</h2>
        <p>{T('Every project was one specific problem, and its field is just what the problem needed. Open a field to see that chapter, or combine two there to see where they met.', 'Každý projekt bol jeden konkrétny problém a jeho odbor je len to, čo problém potreboval. Otvor odbor a uvidíš danú kapitolu, alebo ich tam skombinuj a uvidíš, kde sa stretli.')}</p>
      </div>
      <ul class="fields">
        {Object.entries(fields).map(([k, f]) => (
          <li class={`c-${f.color}`}><a href={lhref(lang, `projects/?field=${k}`)}><h3>{tr(f.label, lang)}</h3><p>{tr(f.hint, lang)}</p><span class="cnt">{counts.get(k) ?? 0} {T('projects', 'projektov')}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block nj" aria-labelledby="nj">
    <div class="wrap split">
      <div>
        <h2 id="nj">NightJar.Gift: {T('a wooden nightjar that sings', 'drevený lelek, ktorý spieva')}</h2>
        <p class="lead">{T('A 3D model became CNC toolpaths, then two halves of beech with a circuit that has no microcontroller and no firmware. Hold the button on its back and it churrs; let go and it sleeps.', '3D model sa stal dráhami pre CNC, potom dvoma polovicami buku s obvodom bez mikrokontroléra a bez firmvéru. Podrž tlačidlo na jeho chrbte a vrčí; pusti a zaspí.')}</p>
        <p class="temp" role="note"><b>{T('Temporary model.', 'Dočasný model.')}</b> {T('The 3D bird above is a stand-in, not the final version of the model.', 'Trojrozmerný lelok vyššie je zástupný, nie konečná verzia modelu.')}</p>
        <div class="cta">
          <a class="btn primary" href={lhref(lang, 'projects/nightjar-gift/')}>{T('Read the story', 'Prečítať príbeh')}</a>
          <a class="btn ghost" href={links.nightjar} rel="noopener" target="_blank">nightjar.gift <Icon name="ext" /></a>
        </div>
      </div>
      <img class="lel-img" src="/img/nightjar-gift.png" alt={T('NightJar.Gift promo picture', 'Promo obrázok NightJar.Gift')} loading="lazy" width="1200" height="630" data-zoom />
    </div>
  </section>

  <section class="block band" aria-labelledby="art">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="art">{T('Art that had to solve something', 'Umenie, ktoré malo niečo vyriešiť')}</h2>
        <p>{T('A logo that must hold up, a story told in letters, a character that has to read at a glance. The graphic design school came before the code, and it still shapes how I build.', 'Logo, ktoré musí obstáť, príbeh vyrozprávaný písmenami, postava, ktorá sa musí čítať na prvý pohľad. Škola grafického dizajnu prišla pred kódom a stále formuje to, ako stavam.')}</p>
      </div>
      <div class="grid g3 art4">{art.map((p) => <ProjectCard p={p} lang={lang} compact />)}</div>
      <p class="more"><a class="btn ghost" href={lhref(lang, 'art/')}>{T('The whole art side', 'Celá umelecká strana')}</a></p>
    </div>
  </section>

  <section class="block contact" aria-labelledby="hi">
    <div class="wrap narrow center">
      <h2 id="hi">{T('Have a thing that should exist?', 'Máš vec, ktorá by mala existovať?')}</h2>
      <p class="lead">{T('Tell me what it should do. I will tell you honestly which parts are code, which are copper and which are wood.', 'Povedz mi, čo má robiť. Poviem ti úprimne, ktoré časti budú kód, ktoré meď a ktoré drevo.')}</p>
      <div class="cta mid"><a class="btn primary" href={`mailto:${person.email}`}>{person.email}</a><a class="btn ghost" href={lhref(lang, 'contact/')}>{T('More ways to reach me', 'Ďalšie spôsoby kontaktu')}</a></div>
    </div>
  </section>
</Base>

<style>
  /* the hero is one row, so it is only as tall as the cards; no rule below, it melts into the band after it */
  .hero { isolation: isolate; background: var(--bg2); position: relative; overflow: hidden; display: flex; align-items: stretch; padding: clamp(1rem, 2.5vw, 2rem) max(var(--gutter), calc((100% - var(--maxw)) / 2)) 0; }
  /* the same low glow the starred band uses, in blue, pooling under the fan */
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 120% at 72% 100%, color-mix(in srgb, var(--blue) 17%, transparent), transparent 70%),
      radial-gradient(90% 80% at 0% 0%, color-mix(in srgb, var(--bg) 60%, transparent), transparent 70%); }
  /* one row: the column bounds sit on the hero's padding, the heading and the fan share the space inside them */
  .hero > .wrap { width: auto; margin: 0; }
  .hero > .wrap:first-child { flex: none; align-self: center; margin-right: 1.5rem; }
  .hero > :global(.fan-wrap) { flex: 1; min-width: 0; align-self: flex-end; }
  .hero h1 { position: relative; padding-left: .55em; margin: 0; max-width: 7ch; font-size: clamp(2.2rem, 6vw, 4.4rem); line-height: 1.04; letter-spacing: -.025em; text-wrap: balance; }
  .hero h1::before { content: ''; position: absolute; left: 0; top: .12em; bottom: .12em; width: .22em; background: var(--blue); transform: skewX(var(--shear)); }
  .hero :global(.fan) { --cw: clamp(130px, 14vw, 180px); margin-top: 0; }
  @media (max-width: 640px) {
    .hero { flex-direction: column; }
    .hero > .wrap:first-child { align-self: flex-start; }
    .hero > :global(.fan-wrap) { width: 100%; flex: none; }
    .hero :global(.fan) { --cw: 104px; }
  }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; }
  .cta.mid { justify-content: center; margin-top: 1.4rem; }
  .more { margin-top: 1.6rem; }
  /* the most-starred band is lit from one corner: a low amber glow off the top left, the far side sinking toward black */
  .band.lit { background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--yellow) 7%, transparent), transparent 60%),
    radial-gradient(90% 80% at 100% 100%, color-mix(in srgb, var(--bg) 70%, transparent), transparent 70%), var(--bg2); }
  /* the desk illustration (the workbench itself) leans on the right rail and fades up into the band */
  .band.corner { isolation: isolate; overflow: hidden; }
  .corner-art { position: absolute; right: max(6px, calc((100% - min(100% - 2 * var(--gutter), var(--maxw))) / 2 - clamp(8px, 2.5vw, 32px))); bottom: 0; z-index: -1; pointer-events: none; display: block;
    width: min(46vw, 560px); height: auto; opacity: .42; -webkit-mask-image: linear-gradient(to top left, #000 30%, transparent 78%); mask-image: linear-gradient(to top left, #000 30%, transparent 78%); }
  :global(:root[data-theme='dark']) .corner-art { filter: invert(.9) hue-rotate(180deg); }
  .fields { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); column-gap: clamp(1.5rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .fields li { --c: var(--blue); border-bottom: 1px solid var(--line); }
  .fields a { display: grid; grid-template-columns: 1fr auto; gap: .2rem 1.5rem; align-items: baseline; padding: 1.1rem 0 1.2rem; text-decoration: none; color: var(--ink); }
  .fields h3 { margin: 0; color: var(--c); transition: color .15s; } .fields p { grid-column: 1; margin: 0; color: var(--soft); font-size: .95rem; }
  .fields .cnt { grid-row: 1; grid-column: 2; font: 500 .8rem var(--mono); font-variant-numeric: tabular-nums; color: var(--soft); white-space: nowrap; }
  .fields a:hover h3 { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .nj { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--cobalt) 7%, transparent)); }
  .lel-img { border: 1px solid var(--line); width: 100%; height: auto; }
  .temp { border: 1px dashed var(--cobalt); padding: .6rem .9rem; font-size: .9rem; line-height: 1.5; color: var(--soft); max-width: 52ch; margin-bottom: 1.4rem; } .temp b { color: var(--cobalt); font-weight: 600; }
  .center { text-align: center; } .center .lead { margin-inline: auto; }
  .contact { border-top: 1px solid var(--line); }
</style>
