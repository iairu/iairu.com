---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import LogoWall from '../../components/LogoWall.astro';
import Gallery from '../../components/Gallery.astro';
import Testimonials from '../../components/Testimonials.astro';
import YouTube from '../../components/YouTube.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { LANGS, ui, tr } from '../../data/i18n.js';
import { booking, links, person } from '../../data/site.js';
import { lhref } from '../../data/util.js';
import { home } from '../../data/content.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = ui[lang];
const h = home;
---
<Base lang={lang} path="">
  <Hero
    eyebrow={tr(h.hero.eyebrow, lang)}
    heading={tr(h.hero.heading, lang)}
    lead={tr(h.hero.lead, lang)}
    bg={h.hero.bg}
    flare={h.hero.flare}
    punch
  >
    <div class="cta" slot="cta">
      <a class="btn" href="#booking">{T.bookNow} <Icon name="next" /></a>
      <a class="btn ghost" href="#show">{tr({ sk: 'Pozrieť show', en: 'See the show' }, lang)}</a>
    </div>
  </Hero>

  <Stats data={h.stats} lang={lang} />

  <LogoWall title={tr(h.referencesTitle, lang)} items={h.references} />

  <!-- About -->
  <section class="section about" id="show" aria-labelledby="about-h">
    <div class="wrap-wide split">
      <figure class="photo" data-reveal>
        <img src={h.about.image} alt={tr(h.about.heading, lang)} loading="lazy" width="900" height="1100" data-zoom />
      </figure>
      <div class="text" data-reveal>
        <h2 id="about-h">{tr(h.about.heading, lang)}</h2>
        {tr(h.about.body, lang).split('\n\n').map((p) => <p class="body" set:html={p} />)}
        <div class="cta">
          <a class="btn ghost" href={links.instagram} rel="noopener" target="_blank"><Icon name="instagram" /> Instagram</a>
          <a class="btn ghost" href={links.youtube} rel="noopener" target="_blank"><Icon name="youtube" /> YouTube</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Two show formats -->
  <section class="section band shows" aria-label={tr(h.shows.heading, lang)}>
    <div class="wrap-wide">
      <div class="two">
        {h.shows.items.map((s, i) => (
          <article class="show-card" data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{tr(s.name, lang)}</h3>
            {tr(s.body, lang).split('\n\n').map((p) => <p set:html={p} />)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="quote-band">
    <div class="narrow center">
      <p class="quote">{tr(h.quote, lang)[0]}<span class="mark">{tr(h.quote, lang)[1]}<svg class="flourish" viewBox="0 0 200 18" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M2 11 C 46 3, 74 3, 100 9 S 158 15, 198 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg></span>{tr(h.quote, lang)[2]}</p>
    </div>
  </section>

  <Gallery title={tr(h.galleryTitle, lang)} items={h.gallery} lang={lang} hint={T.galleryHint} />

  <!-- Video -->
  <section class="section band video" aria-label={tr(h.video.heading, lang)}>
    <div class="wrap">
      <div data-reveal>
        <YouTube id={h.video.youtubeId} title={tr(h.video.heading, lang)} />
      </div>
    </div>
  </section>

  <Testimonials title={tr(h.testimonialsTitle, lang)} list={tr(h.testimonials, lang)} />

  <!-- Booking -->
  <section class="section booking" id="booking" aria-labelledby="book-h">
    <div class="wrap book-grid">
      <div class="book-intro" data-reveal>
        <h2 id="book-h">{tr(h.booking.heading, lang)}</h2>
        <p class="lead">{tr(h.booking.lead, lang)}</p>
        <ul class="contacts">
          <li><a href={`mailto:${booking.email}`}><Icon name="mail" size="1.2rem" /><span>{booking.email}</span></a></li>
          <li><a href={`tel:${booking.phoneHref}`}><Icon name="phone" size="1.2rem" /><span>{booking.phone}</span></a></li>
          <li class="loc"><span>{person.location[lang]}</span></li>
        </ul>
        <div class="social">
          <a href={links.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" size="1.3rem" /></a>
          <a href={links.youtube} rel="noopener" target="_blank" aria-label="YouTube"><Icon name="youtube" size="1.3rem" /></a>
        </div>
      </div>
      <div class="book-form" data-reveal>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .photo { margin: 0; overflow: hidden; border-radius: var(--radius); }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; cursor: zoom-in; transition: transform 0.6s; }
  .photo:hover img { transform: scale(1.04); }
  .about .body { color: var(--soft); }
  .about .cta { margin-top: 1.6rem; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 2rem); }
  .show-card { padding: clamp(1.8rem, 3vw, 2.6rem); background: var(--bg3); border: 1px solid var(--line); border-radius: var(--radius); position: relative; transition: border-color 0.3s, transform 0.3s; }
  .show-card:hover { border-color: color-mix(in srgb, var(--blue) 50%, transparent); transform: translateY(-4px); }
  .show-card .idx { font-family: var(--display); font-size: 2.6rem; line-height: 1; color: var(--blue); }
  .show-card h3 { margin: 0.8rem 0 0.8rem; }
  .show-card p { color: var(--soft); font-size: 0.98rem; }

  /* the second inverted band: a full neon-red slab with the quote set as a black poster line */
  .quote-band { padding-block: clamp(3.5rem, 8vw, 7rem); background: var(--red); }
  .quote-band .narrow { width: min(100% - 2 * var(--gutter), 1100px); }
  /* italic (slanted Anton) with looser leading than other headlines so the Slovak diacritics and quote marks clear the line above */
  .quote { font-family: var(--display); font-style: italic; text-transform: uppercase; font-size: clamp(2.2rem, 1.2rem + 4.6vw, 5.4rem); line-height: 1.14; color: var(--on-red); margin: 0; text-wrap: balance; }
  /* the key words get the hero's hand-drawn flourish beneath, in the quote's black ink */
  .quote .mark { position: relative; display: inline-block; }
  .quote .flourish { position: absolute; left: -1%; width: 102%; bottom: -0.1em; height: 0.16em; color: currentColor; }

  .video .wrap { max-width: 980px; }

  .booking { background: radial-gradient(110% 80% at 50% 0%, color-mix(in srgb, var(--red) 9%, transparent), transparent 60%), var(--bg); border-top: 1px solid var(--line); }
  .book-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .book-intro .lead { margin-bottom: 1.6rem; }
  .contacts { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .contacts a, .contacts .loc { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--ink); font-size: 1.05rem; }
  .contacts a:hover { color: var(--blue); }
  .contacts .icon { color: var(--red); }
  .contacts .loc { color: var(--soft); padding-left: calc(1.2rem + 0.7rem); }
  .book-intro .social { display: flex; gap: 0.8rem; margin-top: 1.6rem; }
  .book-intro .social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--soft); border: 1px solid var(--line2); border-radius: 50%; transition: color 0.2s, border-color 0.2s, transform 0.2s; }
  .book-intro .social a:hover { color: var(--on-blue); background: var(--blue); border-color: var(--blue); transform: translateY(-2px); }
  .book-form { border: 1px solid var(--line2); background: var(--bg2); padding: clamp(1.4rem, 3vw, 2.4rem); border-radius: var(--radius); }

  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } .two { grid-template-columns: 1fr; } .book-grid { grid-template-columns: 1fr; } }
</style>
