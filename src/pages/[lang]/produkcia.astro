---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import YouTube from '../../components/YouTube.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, ui, tr } from '../../data/i18n.js';
import { management, links } from '../../data/site.js';
import { production as p } from '../../data/content.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = ui[lang];
const title = tr(p.hero.eyebrow, lang);
---
<Base lang={lang} path="produkcia/" title={title} description={tr({ sk: 'Profesionálna video produkcia s kúzlom pre vašu firmu a produkt.', en: 'Professional video production with a touch of magic for your business and product.' }, lang)} image="/media/production-hero-bg.jpg">
  <Hero
    eyebrow={tr(p.hero.eyebrow, lang)}
    heading={tr(p.hero.heading, lang)}
    lead={tr(p.hero.lead, lang)}
    bg={p.hero.bg}
    minh="80vh"
  />

  <!-- Showreel background video (muted, looping) -->
  <section class="reel-bg" aria-label="Showreel">
    <video src={p.hero.video} autoplay muted loop playsinline preload="none" poster={p.hero.bg}></video>
    <div class="reel-scrim"></div>
  </section>

  <!-- Instagram bar -->
  <a class="ig-bar" href={links.instagram} rel="noopener" target="_blank">
    <Icon name="instagram" size="1.4rem" />
    <span>{tr(p.igBar, lang)}</span>
    <Icon name="next" />
  </a>

  <!-- Vertical reel -->
  <section class="section band center" aria-label="Reel">
    <div class="wrap">
      <div data-reveal><YouTube id={tr(p.reel.youtubeId, lang)} ratio="9 / 16" short title="Reel" /></div>
    </div>
  </section>

  <!-- Process -->
  <section class="section process">
    <div class="wrap-wide">
      {p.process.map((stage, si) => (
        <div class="stage" data-reveal>
          <div class="stage-head">
            <span class="step grad-gold">{stage.step}</span>
            <h2>{tr(stage.title, lang)}</h2>
          </div>
          <div class="cards">
            {stage.cards.map((c, i) => (
              <div class="pcard" style={`transition-delay:${i * 70}ms`}>
                <img class="pic" src={c.icon} alt="" aria-hidden="true" loading="lazy" />
                <h3>{tr(c.heading, lang)}</h3>
                <p>{tr(c.sub, lang)}</p>
              </div>
            ))}
          </div>
          {si === 0 && <div class="arrow" aria-hidden="true"><Icon name="down" size="1.6rem" /></div>}
        </div>
      ))}
    </div>
  </section>

  <!-- What you get -->
  <section class="section get" style={`--bg:url('${p.benefits.bg}')`} aria-labelledby="get-h">
    <div class="get-overlay"></div>
    <div class="narrow center" data-reveal>
      <h2 id="get-h">{tr(p.benefits.heading, lang)}</h2>
      <ul class="getlist">
        {tr(p.benefits.items, lang).map((it) => (
          <li><Icon name="next" size="1rem" /><span>{it}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="quote-band"><div class="narrow center"><p class="quote">{tr(p.quote, lang)}</p></div></section>

  <!-- Manager contact -->
  <section class="section mgr" style={`--bg:url('${p.contact.bg}')`} aria-labelledby="mgr-h">
    <div class="mgr-overlay"></div>
    <div class="wrap-wide mgr-inner" data-reveal>
      <h2 id="mgr-h">{tr(p.contact.heading, lang)[0]} <span class="accent">{tr(p.contact.heading, lang)[1]}</span></h2>
      <div class="mgr-grid">
        <ul class="primary">
          <li><a href={`tel:${management.phoneHref}`}><Icon name="phone" /> {management.phone}</a></li>
          <li><a href={`mailto:${management.email}`}><Icon name="mail" /> {management.email}</a></li>
        </ul>
        <ul class="legal">
          <li>{management.name}</li>
          <li>IČO: {management.ico}</li>
          <li>DIČ: {management.dic}</li>
          <li>{management.city}</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .reel-bg { position: relative; height: clamp(40vh, 60vh, 70vh); overflow: hidden; border-bottom: 1px solid var(--line); }
  .reel-bg video { width: 100%; height: 100%; object-fit: cover; }
  .reel-scrim { position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg), transparent 30%, transparent 70%, color-mix(in srgb, var(--bg) 60%, transparent)); pointer-events: none; }

  .ig-bar { display: flex; align-items: center; justify-content: center; gap: 0.8rem; padding: 1.2rem 1.5rem; background: var(--sky-grad); color: var(--on-sky); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.85rem; position: relative; isolation: isolate; }
  .ig-bar::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--gold-grad); opacity: 0; transition: opacity 0.6s ease; }
  .ig-bar:hover::before { opacity: 1; }
  .ig-bar:hover { color: var(--on-gold); }
  .ig-bar .icon:last-child { transition: transform 0.25s; }
  .ig-bar:hover .icon:last-child { transform: translateX(4px); }

  .process .stage { margin-bottom: clamp(2.5rem, 6vw, 4.5rem); position: relative; }
  .process .stage:last-child { margin-bottom: 0; }
  .stage-head { display: flex; align-items: baseline; gap: 1rem; justify-content: center; text-align: center; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .stage-head .step { font-family: var(--display); font-size: clamp(2.2rem, 1.5rem + 3.2vw, 4.2rem); line-height: 1; }
  .stage-head h2 { margin: 0; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .pcard { text-align: center; padding: clamp(1.6rem, 3vw, 2.4rem) 1.2rem; background: var(--bg3); border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 0.3s, transform 0.3s; }
  .pcard:hover { border-color: color-mix(in srgb, var(--sky) 55%, transparent); transform: translateY(-4px); }
  .pcard .pic { width: 64px; height: 64px; margin: 0 auto 1rem; object-fit: contain; filter: grayscale(1) brightness(0) invert(0.9); }
  .pcard h3 { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .pcard p { margin: 0; color: var(--soft); font-size: 0.9rem; }
  .arrow { display: grid; place-items: center; color: var(--sky); margin-top: clamp(1.5rem, 3vw, 2.5rem); }

  .get { isolation: isolate; border-block: 1px solid var(--line); }
  .get::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--bg) center / cover no-repeat; opacity: 0.18; }
  .get-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, var(--bg), color-mix(in srgb, var(--bg) 60%, transparent)); }
  .getlist { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 0.9rem; max-width: 34rem; margin-inline: auto; text-align: left; }
  .getlist li { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: start; font-size: 1.08rem; }
  .getlist .icon { color: var(--sky); margin-top: 0.35em; }

  .quote-band { padding-block: clamp(3.5rem, 8vw, 7rem); background: var(--sky-grad); }
  .quote-band .narrow { width: min(100% - 2 * var(--gutter), 1100px); }
  .quote { font-family: var(--display); text-transform: uppercase; font-size: clamp(2.2rem, 1.2rem + 4.6vw, 5.4rem); line-height: 0.95; color: var(--on-sky); margin: 0; text-wrap: balance; }

  .mgr { isolation: isolate; border-top: 1px solid var(--line); }
  .mgr::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--bg) center / cover no-repeat; opacity: 0.25; }
  .mgr-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--bg) 20%, color-mix(in srgb, var(--bg) 55%, transparent)); }
  .mgr-inner { max-width: 720px; margin-left: auto; margin-right: auto; }
  .mgr h2 { text-align: center; } .mgr .accent { color: var(--sky); }
  .mgr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 3rem; margin-top: 2rem; }
  .mgr-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .primary { text-align: right; } .legal { color: var(--soft); border-left: 1px solid var(--line2); padding-left: 2rem; }
  .primary a { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); font-size: 1.1rem; }
  .primary a:hover { color: var(--sky); } .primary .icon { color: var(--sky); }
  @media (max-width: 680px) {
    .cards { grid-template-columns: 1fr; }
    .mgr-grid { grid-template-columns: 1fr; text-align: center; }
    .primary { text-align: center; } .legal { border-left: 0; padding-left: 0; border-top: 1px solid var(--line2); padding-top: 1.2rem; }
    .primary a { justify-content: center; }
  }
</style>
