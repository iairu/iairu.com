---
import Base from '../../../layouts/Base.astro';
import { LANGS, ui } from '../../../data/i18n.js';
import { docsFor, staticDocsFor } from '../../../data/docs.js';
import { lhref, isExternal } from '../../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const docs = docsFor(lang), staticDocs = staticDocsFor(lang);
---
<Base lang={lang} path="docs/" title={ui[lang].nav.docs}
  description={T('Write-ups, tutorials and documentation that go beyond the portfolio cards.', 'Články, návody a dokumentácia, ktoré presahujú portfóliové karty.')}
  crumbs={[{ label: ui[lang].nav.docs }]}>
  <section class="block">
    <div class="wrap">
      <p class="eyebrow">{T('Documentation', 'Dokumentácia')}</p>
      <h1>{T('Everything past the cards', 'Všetko za hranicou kariet')}</h1>
      <p class="lead">{T('Portfolio cards stay short. The longer story of how things were built lives here, or in the repositories linked from each project.', 'Karty v portfóliu ostávajú krátke. Dlhší príbeh o tom, ako veci vznikli, žije tu alebo v repozitároch, na ktoré odkazuje každý projekt.')}</p>

      <h2 class="sub">{T('Write-ups', 'Články')}</h2>
      <ul class="list">
        {docs.map((d) => (
          <li><a href={lhref(lang, `docs/${d.slug}/`)}>
            <span class="meta">{d.date}{d.translated && <span class="tag">{T("translated", "preložené")}</span>}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</span>
          </a></li>
        ))}
      </ul>

      <h2 class="sub">{T('Documentation and downloads', 'Dokumentácia a súbory na stiahnutie')}</h2>
      <ul class="list">
        {staticDocs.map((d) => (
          <li><a href={d.href} {...(isExternal(d.href) ? { rel: 'noopener', target: '_blank' } : {})}>
            <span class="meta"><span class="tag">{d.tag}</span></span>
            <h3>{d.title}{isExternal(d.href) ? ' ↗' : ''}</h3>
            <p>{d.desc}</p>
          </a></li>
        ))}
      </ul>
      <p class="more">{T('Source code and issues of every project: ', 'Zdrojové kódy a issues každého projektu: ')}<a href="https://github.com/iairu?tab=repositories" rel="noopener">github.com/iairu ↗</a></p>
    </div>
  </section>
</Base>
<style>
  .sub { margin-top: 3rem; }
  .list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .list a { display: flex; flex-direction: column; gap: .3rem; height: 100%; padding: 1.2rem; border: 1px solid var(--line); border-left: 3px solid var(--copper); background: var(--bg2); color: var(--ink); text-decoration: none; transition: transform .2s, border-color .2s; }
  .list a:hover { transform: translateY(-3px); border-color: var(--cyan); }
  .list h3 { margin: 0; } .list p { margin: 0; color: var(--soft); font-size: .95rem; }
  .meta { font: 400 .75rem var(--mono); color: var(--soft); display: flex; gap: .6rem; align-items: center; }
  .more { margin-top: 2rem; }
</style>
