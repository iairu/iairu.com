---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Icon from '../../../components/Icon.astro';
import DocList from '../../../components/DocList.astro';
import { LANGS, ui } from '../../../data/i18n.js';
import { docsFor, staticDocsFor, CATEGORIES } from '../../../data/docs.js';
import { lhref, isExternal } from '../../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const docs = docsFor(lang), staticDocs = staticDocsFor(lang);

// Lighter collections that live on their own subpages, reached by a button below.
const SUBPAGES = ['travel', 'recipes'];
const collections = SUBPAGES.map((cat) => ({ cat, label: CATEGORIES[cat], count: docs.filter((d) => d.category === cat).length })).filter((c) => c.count);
---
<DocsLayout lang={lang} path="docs/" title={ui[lang].nav.docs}
  description={T('Write-ups, tutorials and documentation that go beyond the portfolio cards.', 'Články, návody a dokumentácia, ktoré presahujú portfóliové karty.')}
  crumbs={[{ label: ui[lang].nav.docs }]}>
      <h1>{T('Everything past the cards', 'Všetko za hranicou kariet')}</h1>
      <p class="lead">{T('Portfolio cards stay short. The longer story of how things were built lives here, or in the repositories linked from each project.', 'Karty v portfóliu ostávajú krátke. Dlhší príbeh o tom, ako veci vznikli, žije tu alebo v repozitároch, na ktoré odkazuje každý projekt.')}</p>

      {Object.entries(CATEGORIES).filter(([cat]) => !SUBPAGES.includes(cat)).map(([cat, label]) => docs.some((d) => d.category === cat) && (
        <>
          <h2 class="sub" id={cat}>{label[lang]}</h2>
          <DocList docs={docs.filter((d) => d.category === cat)} lang={lang} />
        </>
      ))}

      {collections.length > 0 && (
        <>
          <h2 class="sub">{T('More collections', 'Ďalšie zbierky')}</h2>
          <p class="lead-sm">{T('Lighter reading that is not the main focus of the site, kept on their own pages.', 'Odľahčenejšie čítanie, ktoré nie je hlavným zameraním stránky, na vlastných podstránkach.')}</p>
          <div class="collections">
            {collections.map((c) => (
              <a class="btn ghost" href={lhref(lang, `docs/${c.cat}/`)}>{c.label[lang]} · {c.count} <Icon name="next" /></a>
            ))}
          </div>
        </>
      )}

      <h2 class="sub">{T('Documentation and downloads', 'Dokumentácia a súbory na stiahnutie')}</h2>
      <ul class="list">
        {staticDocs.map((d) => (
          <li><a href={d.href} {...(isExternal(d.href) ? { rel: 'noopener', target: '_blank' } : {})}>
            <span class="meta"><span class="tag">{d.tag}</span></span>
            <h3>{d.title}{isExternal(d.href) && <> <Icon name="ext" /></>}</h3>
            <p>{d.desc}</p>
          </a></li>
        ))}
      </ul>
      <p class="more">{T('Source code and issues of every project: ', 'Zdrojové kódy a issues každého projektu: ')}<a href="https://github.com/iairu?tab=repositories" rel="noopener">github.com/iairu <Icon name="ext" /></a></p>
</DocsLayout>
<style>
  .sub { margin-top: 3rem; }
  .lead-sm { color: var(--soft); margin: .4rem 0 0; max-width: 60ch; }
  .collections { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.2rem; }
  .list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .list a { display: flex; flex-direction: column; gap: .3rem; height: 100%; padding: 1.2rem; border: 1px solid var(--line); background: var(--bg2); color: var(--ink); text-decoration: none; transition: border-color .2s; }
  .list a:hover { border-color: var(--blue); } .list a:hover h3 { color: var(--blue); }
  .list h3 { margin: 0; } .list p { margin: 0; color: var(--soft); font-size: .95rem; }
  .meta { font: 400 .75rem var(--mono); font-variant-numeric: tabular-nums; color: var(--soft); display: flex; gap: .6rem; align-items: center; }
  .more { margin-top: 2rem; }
</style>
