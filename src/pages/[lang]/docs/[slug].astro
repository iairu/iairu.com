---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, ui } from '../../../data/i18n.js';
import { docsFor } from '../../../data/docs.js';
import { lhref } from '../../../data/util.js';

export const getStaticPaths = () => LANGS.flatMap((lang) => docsFor(lang).map((d) => ({ params: { lang, slug: d.slug }, props: { d } })));
const { lang } = Astro.params;
const { d } = Astro.props;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const toc = d.toc ?? [];
const minLevel = toc.length ? Math.min(...toc.map((t) => t.level)) : 1;
---
<Base lang={lang} path={`docs/${d.slug}/`} title={d.title} description={d.desc || d.title} type="article"
  crumbs={[{ label: ui[lang].nav.docs, href: lhref(lang, 'docs/') }, { label: d.title }]}>
  <article class="block">
    <div class="wrap doc-layout">
      <div class="main">
        {d.translated && <p class="note" role="note">{T('Translated into English from the original Slovak text.', 'Preložené do slovenčiny z pôvodného anglického textu.')}</p>}
        <div class="prose">
          <h1>{d.title}</h1>
          {d.date && <p class="date"><time datetime={d.date}>{d.date}</time></p>}
          <Fragment set:html={d.html} />
        </div>
        <p class="back"><a class="btn ghost" href={lhref(lang, 'docs/')}><Icon name="prev" /> {ui[lang].nav.docs}</a></p>
      </div>

      {toc.length > 0 && (
        <details class="toc" open>
          <summary>{T('On this page', 'Na tejto stránke')}</summary>
          <nav aria-label={T('Table of contents', 'Obsah')}>
            <ul>
              {toc.map((t) => (
                <li data-depth={Math.min(t.level - minLevel, 2)}><a href={`#${t.id}`}>{t.text}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      )}
    </div>
  </article>
</Base>
<style>
  .doc-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); }
  .main { min-width: 0; }
  .date { font: 400 .85rem var(--mono); font-variant-numeric: tabular-nums; color: var(--soft); margin-top: -.6em; }
  .note { border: 1px solid var(--line); padding: .5rem 1rem; background: var(--bg2); max-width: 78ch; font-size: .95rem; color: var(--soft); }
  .back { margin-top: 3rem; }

  /* Table of contents: collapsible on small screens, a sticky rail from 981px up. */
  .toc { order: -1; border: 1px solid var(--line); background: var(--bg2); padding: .4rem 1rem; }
  .toc > summary { cursor: pointer; font: 600 .9rem var(--font); padding: .4rem 0; list-style-position: inside; }
  .toc nav { padding: .4rem 0 .6rem; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .1rem; }
  .toc li[data-depth='1'] { padding-left: .9rem; }
  .toc li[data-depth='2'] { padding-left: 1.8rem; }
  .toc a { display: block; padding: .3rem .4rem; color: var(--soft); text-decoration: none; font-size: .9rem; line-height: 1.35; border-left: 2px solid transparent; border-radius: 2px; }
  .toc a:hover { color: var(--ink); background: var(--bg3); }
  .toc a.active { color: var(--blue); border-left-color: var(--blue); }

  @media (min-width: 981px) {
    .doc-layout { grid-template-columns: minmax(0, 1fr) 16rem; align-items: start; }
    .toc { order: 0; position: sticky; top: calc(var(--hdr) + 1.2rem); max-height: calc(100vh - var(--hdr) - 2.4rem); overflow: auto; border: 0; border-left: 1px solid var(--line); background: none; padding: 0 0 0 1.2rem; }
    .toc > summary { display: none; }
    .toc nav { padding: 0; }
  }
</style>
<script>
  // Highlight the table-of-contents entry for the section currently in view.
  const toc = document.querySelector('.toc');
  if (toc) {
    const sections = [...toc.querySelectorAll('a[href^="#"]')]
      .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
      .filter((s) => s.el);
    if (sections.length) {
      const offset = 90;
      let ticking = false;
      const update = () => {
        ticking = false;
        let active = sections[0];
        for (const s of sections) {
          if (s.el.getBoundingClientRect().top - offset <= 0) active = s;
          else break;
        }
        for (const s of sections) s.a.classList.toggle('active', s === active);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
