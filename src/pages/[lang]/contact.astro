---
import Base from '../../layouts/Base.astro';
import { LANGS, ui } from '../../data/i18n.js';
import { person, links } from '../../data/site.js';
import { lhref, tr } from '../../data/util.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const rows = [
  { k: 'E-mail', v: person.email, href: `mailto:${person.email}`, note: T('Best way. I answer in English or Slovak.', 'Najlepší spôsob. Odpovedám po anglicky alebo slovensky.') },
  { k: 'GitHub', v: 'github.com/iairu', href: links.github, note: T('All code, with issues open.', 'Všetok kód, issues sú otvorené.') },
  { k: 'Messenger', v: 'm.me/iairu', href: links.messenger, note: T('Quick questions.', 'Rýchle otázky.') },
  { k: 'LinkedIn', v: 'linkedin.com/in/iairu', href: links.linkedin, note: T('Work history.', 'Pracovná história.') },
  { k: 'Instagram', v: '@spanik11', href: links.instagram, note: T('Personal. Animation and sketches live on @ayu_animations.', 'Osobný. Animácie a skice sú na @ayu_animations.') },
  { k: 'Instagram', v: '@ayu_animations', href: links.animationInstagram, note: T('Art and animation updates.', 'Novinky o umení a animácii.') },
  { k: 'NightJar.Gift', v: 'nightjar.gift', href: links.nightjar, note: T('The wooden nightjar project.', 'Projekt dreveného leleka.') },
  { k: T('CV', 'Životopis'), v: 'PDF', href: lang === 'sk' ? '/dl/resume-sk.pdf' : '/dl/resume-en.pdf', note: T('Front-end developer / IT technician.', 'Front-end developer / IT technik.') },
];
---
<Base lang={lang} path="contact/" title={ui[lang].nav.contact}
  description={T('Contact Ondrej "iairu" Špánik: e-mail, GitHub and LinkedIn.', 'Kontakt na Ondreja „iairu“ Špánika: e-mail, GitHub a LinkedIn.')}
  crumbs={[{ label: ui[lang].nav.contact }]}>
  <section class="block">
    <div class="wrap">
      <p class="eyebrow">{T('Contact', 'Kontakt')}</p>
      <h1>{T('Say hello', 'Ozvi sa')}</h1>
      <p class="lead">{T('Tell me what the thing should do, who it is for and by when. A few sentences are enough to start.', 'Napíš, čo má vec robiť, pre koho je a dokedy. Na začiatok stačí pár viet.')}</p>
      <dl class="rows">
        {rows.map((r) => (
          <div><dt>{r.k}</dt><dd><a href={r.href} {...(r.href.startsWith('http') ? { rel: 'me noopener' } : {})}>{r.v}</a><small>{r.note}</small></dd></div>
        ))}
      </dl>
      <p class="loc">{person.name} · {person.location[lang]} · {tr(person.pronounced, lang)}</p>
    </div>
  </section>
</Base>
<style>
  .rows { margin: 2.5rem 0 1rem; border-top: 1px solid var(--line); max-width: 760px; }
  .rows > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  dt { font: 500 .75rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--copper); padding-top: .35rem; }
  dd { margin: 0; } dd a { font-size: clamp(1.2rem, 1rem + 1.2vw, 1.8rem); font-weight: 600; word-break: break-word; } dd small { display: block; color: var(--soft); margin-top: .2rem; }
  .loc { font: 400 .85rem var(--mono); color: var(--soft); }
  @media (max-width: 560px) { .rows > div { grid-template-columns: 1fr; gap: .2rem; } }
</style>
