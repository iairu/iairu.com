---
// Three-column documentation shell: category/doc sidebar, content, page table of contents.
// Wraps Base.astro, so it still gets the header, breadcrumbs and footer like every other page.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { lhref } from '../data/util.js';

const { lang, path = '', title, description, crumbs = [], type, sidebar = [], toc = [], prev, next } = Astro.props;
const T = (en, sk) => (lang === 'sk' ? sk : en);
const minLevel = toc.length ? Math.min(...toc.map((t) => t.level)) : 1;
---
<Base lang={lang} path={path} title={title} description={description} crumbs={crumbs} type={type}>
  <div class="block">
    <div class="wrap docs-layout" class:list={{ 'no-sidebar': !sidebar.length, 'no-toc': !toc.length }}>
      {sidebar.length > 0 && (
        <details class="side-nav" open>
          <summary>{T('Documentation', 'Dokumentácia')}</summary>
          <nav aria-label={T('Documentation sections', 'Sekcie dokumentácie')}>
            {sidebar.map((group) => (
              <div class="group">
                <div class="group-label">{group.label}</div>
                <ul>
                  {group.items.map((item) => (
                    <li><a href={lhref(lang, item.href)} aria-current={item.active ? 'page' : undefined}>{item.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>
      )}

      <main class="content">
        <slot />
        {(prev || next) && (
          <nav class="doc-pager" aria-label={T('Page navigation', 'Navigácia stránky')}>
            {prev ? (
              <a class="btn ghost prev" href={lhref(lang, prev.href)}>
                <Icon name="prev" />
                <span><span class="dir">{T('Previous', 'Predchádzajúce')}</span><span class="name">{prev.title}</span></span>
              </a>
            ) : <span />}
            {next ? (
              <a class="btn ghost next" href={lhref(lang, next.href)}>
                <span><span class="dir">{T('Next', 'Nasledujúce')}</span><span class="name">{next.title}</span></span>
                <Icon name="next" />
              </a>
            ) : <span />}
          </nav>
        )}
      </main>

      {toc.length > 0 && (
        <details class="toc" open>
          <summary>{T('On this page', 'Na tejto stránke')}</summary>
          <nav id="toc-nav" aria-label={T('Table of contents', 'Obsah')}>
            <ul>
              {toc.map((t) => (
                <li data-depth={Math.min(t.level - minLevel, 2)}><a href={`#${t.id}`}>{t.text}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      )}
    </div>
  </div>
</Base>
<style>
  .docs-layout { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'sidebar' 'toc' 'content'; gap: clamp(1.5rem, 4vw, 2.5rem); align-items: start; }
  .side-nav, .toc, .content { min-width: 0; }

  /* sidebar: collapsible on narrow screens, a sticky rail once there's room. Reuses the
     "details with the summary hidden at wide widths" trick that the old TOC-only layout used. */
  .side-nav, .toc { grid-area: sidebar; border: 1px solid var(--line); background: var(--bg2); padding: .4rem 1rem; }
  .toc { grid-area: toc; }
  .side-nav > summary, .toc > summary { cursor: pointer; font: 600 .9rem var(--font); padding: .4rem 0; list-style-position: inside; }
  .side-nav nav, .toc nav { padding: .4rem 0 .6rem; }
  .group + .group { margin-top: 1.1rem; }
  .group-label { font: 600 .78rem var(--font); color: var(--soft); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .3rem; }
  .side-nav ul, .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .1rem; }
  .side-nav a, .toc a { display: block; padding: .3rem .4rem; color: var(--soft); text-decoration: none; font-size: .9rem; line-height: 1.35; border-left: 2px solid transparent; border-radius: 2px; }
  .side-nav a:hover, .toc a:hover { color: var(--ink); background: var(--bg3); }
  .side-nav a[aria-current='page'] { color: var(--blue); border-left-color: var(--blue); }
  .toc li[data-depth='1'] { padding-left: .9rem; }
  .toc li[data-depth='2'] { padding-left: 1.8rem; }
  .toc a.active { color: var(--blue); border-left-color: var(--blue); }

  .content { grid-area: content; }
  .doc-pager { margin-top: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .doc-pager .btn { text-align: left; gap: .7rem; height: auto; }
  .doc-pager .next { grid-column: 2; justify-self: end; text-align: right; flex-direction: row-reverse; }
  .doc-pager .dir { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; opacity: .7; }
  .doc-pager .name { display: block; }

  @media (min-width: 760px) {
    .docs-layout { grid-template-columns: 15rem minmax(0, 1fr); grid-template-areas: 'sidebar content' 'toc content'; }
    .docs-layout.no-sidebar { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'content' 'toc'; }
    .side-nav { position: sticky; top: calc(var(--hdr) + 1.2rem); max-height: calc(100vh - var(--hdr) - 2.4rem); overflow: auto; border: 0; border-right: 1px solid var(--line); background: none; padding: 0 1.2rem 0 0; }
    .side-nav > summary { display: none; }
  }

  @media (min-width: 1180px) {
    .docs-layout { grid-template-columns: 15rem minmax(0, 1fr) 16rem; grid-template-areas: 'sidebar content toc'; }
    .docs-layout.no-sidebar { grid-template-columns: minmax(0, 1fr) 16rem; grid-template-areas: 'content toc'; }
    .docs-layout.no-toc { grid-template-columns: 15rem minmax(0, 1fr); grid-template-areas: 'sidebar content'; }
    .docs-layout.no-sidebar.no-toc { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'content'; }
    .toc { position: sticky; top: calc(var(--hdr) + 1.2rem); max-height: calc(100vh - var(--hdr) - 2.4rem); overflow: auto; border: 0; border-left: 1px solid var(--line); background: none; padding: 0 0 0 1.2rem; }
    .toc > summary { display: none; }
  }
</style>
<script>
  // Highlight the table-of-contents entry for the section currently in view.
  const toc = document.querySelector('.toc');
  if (toc) {
    const sections = [...toc.querySelectorAll('a[href^="#"]')]
      .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
      .filter((s) => s.el);
    if (sections.length) {
      const offset = 90;
      let ticking = false;
      const update = () => {
        ticking = false;
        let active = sections[0];
        for (const s of sections) {
          if (s.el.getBoundingClientRect().top - offset <= 0) active = s;
          else break;
        }
        for (const s of sections) s.a.classList.toggle('active', s === active);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
