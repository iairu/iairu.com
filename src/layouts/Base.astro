---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Lightbox from '../components/Lightbox.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ui, LANGS } from '../data/i18n.js';
import { SITE_DESCRIPTION, person } from '../data/site.js';

// path: this page's path after /<lang>/ (used for the language switch and hreflang)
const { lang = 'en', title, description = SITE_DESCRIPTION[lang], path = '', crumbs = [], image = '/img/nightjar-gift.png', noindex = false, type = 'website' } = Astro.props;
const T = ui[lang];
const full = title ? `${title} · ${person.nick}` : `${person.full}: ${lang === 'sk' ? 'prompt inžinier a 3D umelec' : 'prompt engineer & 3D artist'}`;
const origin = Astro.site?.origin ?? '';
const canonical = origin + `/${lang}/${path}`;
const ld = { '@context': 'https://schema.org', '@type': 'Person', name: person.name, alternateName: person.nick, url: origin + '/', email: person.email, jobTitle: 'Prompt engineer, 3D artist', sameAs: ['https://github.com/iairu', 'https://www.linkedin.com/in/iairu'] };
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0f14" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${origin}/${l}/${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${origin}/en/${path}`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={person.full} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={origin + image} />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      (function () {
        var d = document.documentElement; d.classList.add('js'); d.setAttribute('data-sky', String(1 + Math.floor(Math.random() * 6)));
        var t = null; try { t = localStorage.getItem('iairu-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>
    <a class="skip" href="#main">{T.skip}</a>
    <Header lang={lang} path={path} />
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Search lang={lang} />
    <Lightbox lang={lang} />
    <script>
      const root = document.documentElement;
      const meta = document.querySelector('meta[name=theme-color]');
      const paint = () => meta?.setAttribute('content', root.getAttribute('data-theme') === 'light' ? '#f4f2ea' : '#0a0f14');
      paint();
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('iairu-theme', next); } catch {}
        paint();
      });
      document.querySelectorAll<HTMLAnchorElement>('.langs a').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('iairu-lang', a.hreflang); } catch {} }));
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('primary-nav');
      const setMenu = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); };
      btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      nav?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
