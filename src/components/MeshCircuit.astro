---
// Decorative hero art: an icosahedron whose edges are half wireframe (cyan, thin) and
// half PCB traces (copper, thick, with solder pads). Pure SVG, computed at build time.
const { class: cls = '' } = Astro.props;
const phi = (1 + Math.sqrt(5)) / 2;
const raw = [[-1, phi, 0], [1, phi, 0], [-1, -phi, 0], [1, -phi, 0], [0, -1, phi], [0, 1, phi], [0, -1, -phi], [0, 1, -phi], [phi, 0, -1], [phi, 0, 1], [-phi, 0, -1], [-phi, 0, 1]];
const faces = [[0, 11, 5], [0, 5, 1], [0, 1, 7], [0, 7, 10], [0, 10, 11], [1, 5, 9], [5, 11, 4], [11, 10, 2], [10, 7, 6], [7, 1, 8], [3, 9, 4], [3, 4, 2], [3, 2, 6], [3, 6, 8], [3, 8, 9], [4, 9, 5], [2, 4, 11], [6, 2, 10], [8, 6, 7], [9, 8, 1]];
const ay = 0.55, ax = 0.42;
const pts = raw.map(([x, y, z]) => {
  const x1 = x * Math.cos(ay) + z * Math.sin(ay), z1 = -x * Math.sin(ay) + z * Math.cos(ay);
  const y1 = y * Math.cos(ax) - z1 * Math.sin(ax), z2 = y * Math.sin(ax) + z1 * Math.cos(ax);
  const s = 150 / (6 - z2 * 0.5);
  return [300 + x1 * s * 1.9, 300 - y1 * s * 1.9, z2];
});
const edges = new Map();
for (const f of faces) for (let i = 0; i < 3; i++) { const a = f[i], b = f[(i + 1) % 3]; edges.set(a < b ? `${a}-${b}` : `${b}-${a}`, [a, b]); }
const list = [...edges.values()];
// edges whose midpoint lies in the right half become copper traces, snapped to 45 degree turns
const trace = ([a, b]) => {
  const [x1, y1] = pts[a], [x2, y2] = pts[b];
  const dx = x2 - x1, dy = y2 - y1, m = Math.min(Math.abs(dx), Math.abs(dy));
  const kx = x1 + Math.sign(dx) * m, ky = y1 + Math.sign(dy) * m;
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} L${(Math.abs(dx) > Math.abs(dy) ? kx : x1).toFixed(1)} ${(Math.abs(dx) > Math.abs(dy) ? y2 : ky).toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}`;
};
const wire = [], copper = [];
for (const e of list) {
  const mx = (pts[e[0]][0] + pts[e[1]][0]) / 2;
  (mx > 300 ? copper : wire).push(e);
}
---
<svg class={cls} viewBox="0 0 600 600" role="img" aria-label="A 3D wireframe whose right half turns into circuit traces" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="mc-fade" x1="0" x2="1"><stop offset="0" stop-color="var(--cyan)" stop-opacity=".95" /><stop offset="1" stop-color="var(--cyan)" stop-opacity=".35" /></linearGradient>
  </defs>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    {wire.map((e) => <line x1={pts[e[0]][0]} y1={pts[e[0]][1]} x2={pts[e[1]][0]} y2={pts[e[1]][1]} stroke="url(#mc-fade)" stroke-width="1.6" />)}
    {copper.map((e) => <path d={trace(e)} stroke="var(--copper)" stroke-width="5" />)}
    {copper.map((e) => <path d={trace(e)} stroke="var(--bg)" stroke-width="1" opacity=".5" />)}
  </g>
  {pts.map(([x, y], i) => (x > 300
    ? <g><circle cx={x} cy={y} r="11" fill="var(--copper)" /><circle cx={x} cy={y} r="4.5" fill="var(--bg)" /></g>
    : <circle cx={x} cy={y} r="4" fill="var(--bg)" stroke="var(--cyan)" stroke-width="1.8" />))}
</svg>
