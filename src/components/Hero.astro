---
// Full-bleed hero: background photo, soft vignette, an optional lens flare,
// and a two-part poster headline (second word in lime, with a gold sparkle).
const { heading = [], lead, bg, flare, align = 'left', minh = '92vh' } = Astro.props;
---
<section class="hero" style={`--bg:url('${bg}'); --minh:${minh}`} data-align={align}>
  {flare && <img class="flare" src={flare} alt="" aria-hidden="true" />}
  <div class="scrim"></div>
  <div class="wrap-wide inner">
    <div class="copy">
      <h1 class="mm2">
        {heading[0]}{heading[1] && <> <span class="acc">{heading[1]}<svg class="flourish" viewBox="0 0 200 18" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M2 11 C 46 3, 74 3, 100 9 S 158 15, 198 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg><svg class="spark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" /></svg></span></>}
      </h1>
      {lead && <p class="lead">{lead}</p>}
      <slot name="cta" />
    </div>
  </div>
  <div class="fade"></div>
</section>

<style>
  .hero { position: relative; min-height: var(--minh); display: flex; align-items: center; overflow: hidden; padding-top: var(--hdr); isolation: isolate; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background: var(--bg) center / cover no-repeat;
    transform: scale(1.04);
  }
  .scrim { position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.6) 45%, rgb(0 0 0 / 0.2) 100%),
      linear-gradient(0deg, var(--bg) 2%, transparent 40%); }
  [data-align='center'] .scrim { background: radial-gradient(120% 90% at 50% 40%, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.88) 80%), linear-gradient(0deg, var(--bg) 2%, transparent 45%); }
  .flare { position: absolute; z-index: -1; right: -6%; top: 8%; width: min(60vw, 720px); mix-blend-mode: screen; opacity: 0.8; pointer-events: none; }
  .fade { position: absolute; left: 0; right: 0; bottom: 0; height: 160px; background: linear-gradient(0deg, var(--bg), transparent); z-index: -1; }

  .inner { width: min(100% - 2 * var(--gutter), var(--wide)); }
  .copy { max-width: 46rem; }
  [data-align='center'] .inner { text-align: center; }
  [data-align='center'] .copy { max-width: 56ch; margin-inline: auto; }

  h1 { margin: 0.2em 0 0.4em; }
  h1.mm2 { line-height: 0.9; font-size: clamp(3.4rem, 1.6rem + 8.4vw, 9rem); }
  /* the magic word: acid lime with a soft glow, a gold flourish swash beneath and a small gold sparkle — stage-magic ornament */
  .acc { position: relative; color: var(--lime); display: inline-block; text-shadow: 0 0 40px color-mix(in srgb, var(--lime) 35%, transparent); }
  .acc .flourish { position: absolute; left: -1%; width: 102%; bottom: -0.12em; height: 0.16em; color: var(--gold); }
  .acc .spark { position: absolute; right: -0.5em; top: -0.04em; width: 0.32em; height: 0.32em; color: var(--gold-bright); }
  .hero .lead { margin-bottom: 2rem; color: var(--ink); opacity: 0.88; }
  :global(.hero .cta) { margin-top: 0.4rem; }

  @media (max-width: 700px) { .hero { min-height: 86vh; } .copy { max-width: 100%; } }
  /* on phones stack the accent word on its own line so long headings never overflow */
  @media (max-width: 560px) {
    .hero h1.mm2 { font-size: clamp(3rem, 1.8rem + 11vw, 4.6rem); }
    .acc { display: block; }
  }
</style>
