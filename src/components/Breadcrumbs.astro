---
import { ui } from '../data/i18n.js';
import { lhref } from '../data/util.js';
// crumbs: [{ label, href? }] after Home; the last one is the current page.
const { lang, crumbs = [] } = Astro.props;
const all = [{ label: ui[lang].nav.home, href: lhref(lang) }, ...crumbs];
const origin = Astro.site ? Astro.site.origin : '';
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: origin + c.href } : {}) })),
};
---
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label={ui[lang].breadcrumbs}>
    <ol>
      {all.map((c, i) => (
        <li>{i < all.length - 1 && c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
      ))}
    </ol>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </nav>
)}
<style>
  .crumbs { padding-block: 1.2rem .4rem; font: 400 .78rem var(--mono); }
  ol { display: flex; flex-wrap: wrap; gap: .3rem; list-style: none; margin: 0; padding: 0; color: var(--soft); }
  li + li::before { content: '/'; color: var(--copper); margin-right: .3rem; }
  a { color: var(--soft); } a:hover { color: var(--cyan); }
  [aria-current] { color: var(--ink); }
</style>
