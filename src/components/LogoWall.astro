---
const { title, items = [] } = Astro.props;
---
<section class="logowall section-sm" aria-label={title}>
  <div class="wrap-wide">
    {title && <p class="eyebrow center">{title}</p>}
    <ul class="logos">
      {items.map((logo) => (
        <li><img src={logo.src} alt={logo.alt} loading="lazy" /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logowall { border-bottom: 1px solid var(--line); }
  .eyebrow.center { display: flex; justify-content: center; margin-bottom: 2rem; }
  .logos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: clamp(1.8rem, 4vw, 3.6rem); }
  .logos li { display: flex; align-items: center; }
  .logos img { height: clamp(28px, 4vw, 42px); width: auto; object-fit: contain; filter: grayscale(1) brightness(0) invert(1); opacity: 0.6; transition: opacity 0.3s, filter 0.3s; }
  .logos li:hover img { opacity: 1; filter: grayscale(1) brightness(0) invert(1); }
</style>
