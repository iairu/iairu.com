---
// Click-to-load YouTube facade: shows the poster until the visitor presses play,
// then swaps in the privacy-friendly nocookie iframe. Keeps the page light.
const { id, title = 'Video', ratio = '16 / 9', short = false } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class:list={['yt', { short }]} style={`--ratio:${ratio}`} data-id={id}>
  <button class="yt-play" type="button" aria-label={`Play: ${title}`}>
    <img
      class="yt-poster"
      src={poster}
      alt=""
      loading="lazy"
      width="1280"
      height="720"
      onerror={`this.onerror=null;this.src='${posterFallback}'`}
    />
    <span class="yt-btn" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.5 34 .5 34 .5S12.8.5 7.5 1.7a8.6 8.6 0 0 0-6 6A89 89 0 0 0 .5 24a89 89 0 0 0 1 16.3 8.6 8.6 0 0 0 6 6C12.8 47.5 34 47.5 34 47.5s21.2 0 26.5-1.2a8.6 8.6 0 0 0 6-6A89 89 0 0 0 67.5 24a89 89 0 0 0-1-16.3z" fill="#d1a645"/><path d="M27 34l18-10-18-10z" fill="#0a0a0c"/></svg>
    </span>
  </button>
</div>

<style>
  .yt { position: relative; aspect-ratio: var(--ratio); width: 100%; background: #000; overflow: hidden; border: 1px solid var(--line); }
  .yt.short { max-width: 360px; margin-inline: auto; }
  .yt-play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .yt-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s, opacity 0.3s; }
  .yt-play:hover .yt-poster { transform: scale(1.03); opacity: 0.85; }
  .yt-btn { position: relative; z-index: 1; filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.5)); transition: transform 0.25s; }
  .yt-play:hover .yt-btn { transform: scale(1.08); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('.yt-play')?.addEventListener('click', () => {
      const id = el.dataset.id;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = 'YouTube video';
      el.innerHTML = '';
      el.appendChild(iframe);
    });
  });
</script>
