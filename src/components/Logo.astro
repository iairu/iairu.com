// draw the eye into a copper pad, then the wordmark: five hand-built letters on one stroke weight,
// the two i's carrying the palette (cyan stems, copper solder-pad dots).
// Theme-aware through CSS variables, so it works on both backgrounds.
const { height = 28, class: cls = '' } = Astro.props;
