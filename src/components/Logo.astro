---
// The iairu wordmark: five hand-built letters on one stroke weight, squared stems like the
// site's buttons. The two i's carry the palette (cyan stems, copper solder-pad dots).
// Theme-aware through CSS variables, so it works on both backgrounds.
const { height = 28, class: cls = '' } = Astro.props;
---
<svg class={`logo ${cls}`} viewBox="-1 -1 65 27" height={height} width={(height * 65) / 27} role="img" aria-label="iairu" fill="none" stroke-width="3">
  <g class="i" stroke="var(--cyan)"><path d="M1.5 8V24"/><path d="M28.5 8V24"/></g>
  <g class="dot" fill="var(--copper)" stroke="none"><circle cx="1.5" cy="2.6" r="2.3"/><circle cx="28.5" cy="2.6" r="2.3"/></g>
  <g class="ink" stroke="currentColor">
    <circle cx="15" cy="16" r="6.5"/><path d="M21.5 8V24"/>
    <path d="M35.5 8V24"/><path d="M35.5 18C35.5 12.5 39 9.5 44.5 9.5"/>
    <path d="M49.5 8V16.5A6 6 0 0 0 61.5 16.5V8"/><path d="M61.5 16.5V24"/>
  </g>
</svg>
<style>
  .logo { display: block; width: auto; color: var(--ink); overflow: visible; }
</style>
