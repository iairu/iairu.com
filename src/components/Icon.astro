};
const isFilled = name in filled;
---
{isFilled ? (
  <svg class={`icon icon-${name}`} viewBox="0 0 24 24" width={size} height={size} fill="currentColor"
    {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })} set:html={filled[name]} />
) : (
  <svg class={`icon icon-${name}`} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
    {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })} set:html={stroke[name]} />
)}
<style>.icon { display: inline-block; vertical-align: -0.12em; flex: none; }</style>
