---
// Small inline icons drawn in one stroke weight, used instead of Unicode glyphs (★ ↗ ← → ↑).
const { name, size = '1em', label } = Astro.props;
const paths = {
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
  ext: '<path d="M8 6h10v10M18 6L6 18"/>',
  prev: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  next: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  up: '<path d="M12 19V5M6 11l6-6 6 6"/>',
};
---
<svg class={`icon icon-${name}`} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })} set:html={paths[name]} />
