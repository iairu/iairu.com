---
import MeshCircuit from './MeshCircuit.astro';
const { lang = 'en' } = Astro.props;
const L = lang === 'sk'
  ? { solid: 'Drevo', circuit: 'Výkres', spin: 'Otáčanie', load: 'Načítavam 3D model NightJar.Gift…', hint: 'Potiahni prstom alebo myšou a otoč lelka.', badge: 'Návrh v2', warn: 'Toto je aktuálny návrh (Nightjar v2), nie hotový vták: zatiaľ nič nebolo vyrezané, takže skutočný lelek sa ešte môže líšiť.', nogl: '3D zobrazenie vyžaduje WebGL.', fail: 'Model sa nepodarilo načítať.' }
  : { solid: 'Wood', circuit: 'Blueprint', spin: 'Spin', load: 'Loading the NightJar.Gift 3D model…', hint: 'Drag to turn the bird.', badge: 'Design v2', warn: 'This is the current design (Nightjar v2), not a finished bird: nothing has been carved yet, so the real one may still differ.', nogl: '3D view needs WebGL.', fail: 'Could not load the model.' };
---
<div class="viewer" data-viewer data-model="/models/nightjar.stl" data-button="/models/nightjar_button.stl" data-internals="/models/nightjar_internals.stl" data-fail={L.fail} data-nogl={L.nogl}>
  <div class="poster" data-loading>
    <MeshCircuit class="poster-art" />
    <p class="load">{L.load}</p>
  </div>
  <canvas aria-label="3D model of the NightJar.Gift wooden nightjar" role="img"></canvas>
  <div class="ctrl" role="group" aria-label="3D view">
    <button type="button" data-mode="solid" aria-pressed="true" class="on">{L.solid}</button>
    <button type="button" data-mode="circuit" aria-pressed="false">{L.circuit}</button>
    <button type="button" data-spin aria-pressed="true" class="on">{L.spin}</button>
  </div>
  <p class="badge" role="note"><b>{L.badge}</b><span>{L.warn}</span></p>
  <p class="cap">{L.hint}</p>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasGL = () => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } };

  async function boot(root: HTMLElement) {
    const loading = root.querySelector<HTMLElement>('[data-loading]')!;
    if (!hasGL()) { loading.querySelector('.load')!.textContent = root.dataset.nogl!; return; }
    const THREE = await import('three');
    const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { mergeVertices } = await import('three/examples/jsm/utils/BufferGeometryUtils.js');
    const canvas = root.querySelector('canvas')!;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 1, 3000);
    camera.position.set(-330, 150, 420);
    scene.add(new THREE.HemisphereLight(0xfff1dc, 0x24303a, 1.3));
    const key = new THREE.DirectionalLight(0xffe2b8, 2.4); key.position.set(200, 320, 260); scene.add(key);
    const rim = new THREE.DirectionalLight(0x78a9ff, 1.4); rim.position.set(-260, 120, -240); scene.add(rim);
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true; controls.enablePan = false; controls.enableZoom = false;
    controls.autoRotate = !reduce; controls.autoRotateSpeed = 1.2;

    const loader = new STLLoader();
    const [g1, g2, g3] = await Promise.all([root.dataset.model!, root.dataset.button!, root.dataset.internals!].map((u) => loader.loadAsync(u)));
    const prep = (g: any) => { g.deleteAttribute('normal'); const m = mergeVertices(g, 0.05); m.computeVertexNormals(); m.rotateX(-Math.PI / 2); return m; };
    const body = prep(g1), btn = prep(g2), inner = prep(g3);
    body.computeBoundingBox();
    const c = new THREE.Vector3(); body.boundingBox!.getCenter(c);
    const group = new THREE.Group();
    const wood = new THREE.MeshStandardMaterial({ color: 0xc9a074, roughness: 0.62 });
    const woodBtn = new THREE.MeshStandardMaterial({ color: 0x8a5a32, roughness: 0.5 });
    // blueprint: see-through blue shell without edges or depth writes, electronics visible inside from every angle
    const ghost = new THREE.MeshBasicMaterial({ color: 0x5fb4e8, transparent: true, opacity: 0.22, depthWrite: false });
    const innerFill = new THREE.MeshBasicMaterial({ color: 0x4589ff, transparent: true, opacity: 0.35 });
    const bodyMesh = new THREE.Mesh(body, wood), btnMesh = new THREE.Mesh(btn, woodBtn);
    const innerMesh = new THREE.Mesh(inner, innerFill);
    const innerEdges = new THREE.LineSegments(new THREE.EdgesGeometry(inner, 30), new THREE.LineBasicMaterial({ color: 0xffc89a }));
    bodyMesh.renderOrder = btnMesh.renderOrder = 1;
    innerMesh.visible = innerEdges.visible = false;
    group.add(innerMesh, innerEdges, bodyMesh, btnMesh);
    group.position.sub(c);
    scene.add(group);

    let visible = false, raf = 0;
    const resize = () => { const w = root.clientWidth, h = root.clientHeight; renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); };
    const tick = () => { raf = 0; if (!visible) return; controls.update(); renderer.render(scene, camera); raf = requestAnimationFrame(tick); };
    new ResizeObserver(resize).observe(root); resize();
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible && !raf) raf = requestAnimationFrame(tick); }).observe(root);
    root.classList.add('ready'); loading.hidden = true;

    const modes = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    modes.forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.mode;
      const solid = m === 'solid';
      bodyMesh.material = solid ? wood : ghost; btnMesh.material = solid ? woodBtn : ghost;
      innerMesh.visible = innerEdges.visible = !solid;
      modes.forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    }));
    const spin = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const setSpin = (on: boolean) => { controls.autoRotate = on; spin.setAttribute('aria-pressed', String(on)); spin.classList.toggle('on', on); };
    setSpin(!reduce);
    spin.addEventListener('click', () => setSpin(!controls.autoRotate));
    controls.addEventListener('start', () => { if (controls.autoRotate) setSpin(false); });
  }

  // fetch three.js and the 3 MB model only once the viewer is near the viewport
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((el) => {
    const io = new IntersectionObserver((es) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      boot(el).catch((e) => { console.error(e); el.querySelector('.load')!.textContent = el.dataset.fail!; });
    }, { rootMargin: '300px' });
    io.observe(el);
  });

  // The viewer is a thin board on the bench: it leans a few degrees toward the pointer anywhere on the page.
  // The model inside keeps its own drag and spin.
  function tiltBoards(boards: HTMLElement[]) {
    if (reduce || !boards.length) return;
    let raf = 0;
    const clamp = (v: number) => Math.max(-1, Math.min(1, v));
    const set = (x: number, y: number) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => boards.forEach((b) => { b.style.setProperty('--tx', x.toFixed(3)); b.style.setProperty('--ty', y.toFixed(3)); }));
    };
    if (matchMedia('(pointer: fine)').matches) {
      addEventListener('pointermove', (e) => {
        const r = boards[0].getBoundingClientRect();
        set(clamp((e.clientX - (r.left + r.width / 2)) / (innerWidth / 2)), clamp((e.clientY - (r.top + r.height / 2)) / (innerHeight / 2)));
      }, { passive: true });
      document.documentElement.addEventListener('pointerleave', () => set(0, 0));
    }
  }
  tiltBoards([...document.querySelectorAll<HTMLElement>('[data-viewer]')]);
</script>

<style>
  .viewer { position: relative; aspect-ratio: 1 / 1; max-height: 640px; width: 100%; border: 1px solid var(--line); background: radial-gradient(70% 70% at 50% 45%, color-mix(in srgb, var(--blue) 12%, var(--bg2)), var(--bg2)); overflow: hidden; touch-action: pan-y; }
  /* a low board: up to ~4 degrees of lean, its edge showing as a stack of thin layers on the low side */
  .viewer { --tx: 0; --ty: 0; transform: perspective(1600px) rotateY(calc(var(--tx) * 4deg)) rotateX(calc(var(--ty) * -3deg));
    box-shadow: calc(var(--tx) * -1px) calc(var(--ty) * -1px + 1px) 0 var(--bg3), calc(var(--tx) * -2px) calc(var(--ty) * -2px + 2px) 0 var(--bg3),
      calc(var(--tx) * -3px) calc(var(--ty) * -3px + 3px) 0 var(--line), calc(var(--tx) * -14px) calc(var(--ty) * -10px + 22px) 34px -18px rgb(0 0 0 / .7);
    transition: transform .9s cubic-bezier(.16, 1, .3, 1), box-shadow .9s cubic-bezier(.16, 1, .3, 1); }
  .viewer::before, .viewer::after { content: ''; position: absolute; width: 22px; height: 22px; border: 2px solid var(--cobalt); pointer-events: none; z-index: 3; }
  .viewer::before { top: 8px; left: 8px; border-right: 0; border-bottom: 0; }
  .viewer::after { bottom: 8px; right: 8px; border-left: 0; border-top: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; opacity: 0; transition: opacity .6s; touch-action: pan-y; }
  .ready canvas { opacity: 1; } canvas:active { cursor: grabbing; }
  .poster { position: absolute; inset: 0; display: grid; place-items: center; z-index: 1; transition: opacity .5s; }
  .poster[hidden] { display: none; }
  .poster-art { width: min(86%, 520px); height: auto; animation: float 8s ease-in-out infinite; }
  .load { position: absolute; bottom: 3.2rem; left: 0; right: 0; text-align: center; margin: 0; font-size: .85rem; color: var(--soft); }
  @keyframes float { 50% { transform: translateY(-8px) rotate(1.5deg); } }
  .ctrl { position: absolute; top: 12px; right: 12px; z-index: 4; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }
  .ctrl button { font: 500 .82rem var(--font); padding: .5em .75em; min-height: 36px; background: var(--bg); color: var(--ink); border: 1px solid var(--line2); cursor: pointer; border-radius: 2px; }
  .ctrl button.on { background: var(--blue); color: var(--on-accent); border-color: var(--blue); }
  .badge { position: absolute; top: 12px; left: 12px; z-index: 4; margin: 0; max-width: min(15rem, calc(100% - 24px - 11.5rem)); display: grid; gap: .25rem; padding: .5rem .65rem; background: var(--bg); border: 1px dashed var(--cobalt); font-size: .78rem; line-height: 1.4; color: var(--soft); }
  .badge b { color: var(--cobalt); font-weight: 600; }
  @media (max-width: 560px) { .badge { max-width: none; right: 12px; top: auto; bottom: 34px; } .ctrl { top: 10px; left: 12px; justify-content: flex-start; } }
  .cap { position: absolute; bottom: 10px; left: 14px; right: 14px; z-index: 4; margin: 0; font-size: .8rem; color: var(--soft); pointer-events: none; }
</style>
