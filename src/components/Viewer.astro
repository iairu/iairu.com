---
import MeshCircuit from './MeshCircuit.astro';
const { lang = 'en' } = Astro.props;
const L = lang === 'sk'
  ? { solid: 'Drevo', wire: 'Drôtený model', circuit: 'Výkres', spin: 'Otáčanie', load: 'Načítavam 3D model LELEK…', hint: 'Potiahni myšou a otoč lelka. Tvar je skutočný CNC model.', nogl: '3D zobrazenie vyžaduje WebGL.', fail: 'Model sa nepodarilo načítať.' }
  : { solid: 'Wood', wire: 'Wireframe', circuit: 'Blueprint', spin: 'Spin', load: 'Loading the LELEK 3D model…', hint: 'Drag to turn the bird. This is the real CNC model.', nogl: '3D view needs WebGL.', fail: 'Could not load the model.' };
---
<div class="viewer" data-viewer data-model="/models/nightjar.stl" data-button="/models/nightjar_button.stl" data-fail={L.fail} data-nogl={L.nogl}>
  <div class="poster" data-loading>
    <MeshCircuit class="poster-art" />
    <p class="load">{L.load}</p>
  </div>
  <canvas aria-label="3D model of the LELEK wooden nightjar" role="img"></canvas>
  <div class="ctrl" role="group" aria-label="3D view">
    <button type="button" data-mode="solid" aria-pressed="true" class="on">{L.solid}</button>
    <button type="button" data-mode="wire" aria-pressed="false">{L.wire}</button>
    <button type="button" data-mode="circuit" aria-pressed="false">{L.circuit}</button>
    <button type="button" data-spin aria-pressed="true" class="on">{L.spin}</button>
  </div>
  <p class="cap">{L.hint}</p>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasGL = () => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } };

  async function boot(root: HTMLElement) {
    const loading = root.querySelector<HTMLElement>('[data-loading]')!;
    if (!hasGL()) { loading.querySelector('.load')!.textContent = root.dataset.nogl!; return; }
    const THREE = await import('three');
    const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { mergeVertices } = await import('three/examples/jsm/utils/BufferGeometryUtils.js');
    const canvas = root.querySelector('canvas')!;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 1, 3000);
    camera.position.set(-330, 150, 420);
    scene.add(new THREE.HemisphereLight(0xfff1dc, 0x24303a, 1.3));
    const key = new THREE.DirectionalLight(0xffe2b8, 2.4); key.position.set(200, 320, 260); scene.add(key);
    const rim = new THREE.DirectionalLight(0x3fe0d0, 1.4); rim.position.set(-260, 120, -240); scene.add(rim);
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true; controls.enablePan = false; controls.enableZoom = false;
    controls.autoRotate = !reduce; controls.autoRotateSpeed = 1.2;

    const loader = new STLLoader();
    const [g1, g2] = await Promise.all([loader.loadAsync(root.dataset.model!), loader.loadAsync(root.dataset.button!)]);
    const prep = (g: any) => { g.deleteAttribute('normal'); const m = mergeVertices(g, 0.05); m.computeVertexNormals(); m.rotateX(-Math.PI / 2); return m; };
    const body = prep(g1), btn = prep(g2);
    body.computeBoundingBox();
    const c = new THREE.Vector3(); body.boundingBox!.getCenter(c);
    const group = new THREE.Group();
    const wood = new THREE.MeshStandardMaterial({ color: 0xc9a074, roughness: 0.62 });
    const woodBtn = new THREE.MeshStandardMaterial({ color: 0x8a5a32, roughness: 0.5 });
    const ghost = new THREE.MeshBasicMaterial({ color: 0x0b2230, transparent: true, opacity: 0.8, polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1 });
    const bodyMesh = new THREE.Mesh(body, wood), btnMesh = new THREE.Mesh(btn, woodBtn);
    const edgeCyan = new THREE.LineBasicMaterial({ color: 0x3fe0d0 });
    const edgeCopper = new THREE.LineBasicMaterial({ color: 0xff9a52 });
    const bodyEdges = new THREE.LineSegments(new THREE.EdgesGeometry(body, 22), edgeCyan);
    const btnEdges = new THREE.LineSegments(new THREE.EdgesGeometry(btn, 22), edgeCopper);
    bodyEdges.visible = btnEdges.visible = false;
    group.add(bodyMesh, btnMesh, bodyEdges, btnEdges);
    group.position.sub(c);
    scene.add(group);

    let visible = false, raf = 0;
    const resize = () => { const w = root.clientWidth, h = root.clientHeight; renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); };
    const tick = () => { raf = 0; if (!visible) return; controls.update(); renderer.render(scene, camera); raf = requestAnimationFrame(tick); };
    new ResizeObserver(resize).observe(root); resize();
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible && !raf) raf = requestAnimationFrame(tick); }).observe(root);
    root.classList.add('ready'); loading.hidden = true;

    const modes = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    modes.forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.mode;
      const solid = m === 'solid';
      bodyMesh.visible = btnMesh.visible = solid || m === 'circuit';
      bodyMesh.material = solid ? wood : ghost; btnMesh.material = solid ? woodBtn : ghost;
      bodyEdges.visible = btnEdges.visible = !solid;
      bodyEdges.material = edgeCyan; btnEdges.material = edgeCopper;
      if (m === 'wire') { bodyMesh.visible = btnMesh.visible = false; }
      modes.forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    }));
    const spin = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const setSpin = (on: boolean) => { controls.autoRotate = on; spin.setAttribute('aria-pressed', String(on)); spin.classList.toggle('on', on); };
    setSpin(!reduce);
    spin.addEventListener('click', () => setSpin(!controls.autoRotate));
    controls.addEventListener('start', () => { if (controls.autoRotate) setSpin(false); });
  }

  // fetch three.js and the 3 MB model only once the viewer is near the viewport
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((el) => {
    const io = new IntersectionObserver((es) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      boot(el).catch((e) => { console.error(e); el.querySelector('.load')!.textContent = el.dataset.fail!; });
    }, { rootMargin: '300px' });
    io.observe(el);
  });
</script>

<style>
  .viewer { position: relative; aspect-ratio: 1 / 1; max-height: 640px; width: 100%; border: 1px solid var(--line); background: radial-gradient(70% 70% at 50% 45%, color-mix(in srgb, var(--cyan) 12%, var(--bg2)), var(--bg2)); overflow: hidden; touch-action: pan-y; }
  .viewer::before, .viewer::after { content: ''; position: absolute; width: 22px; height: 22px; border: 2px solid var(--copper); pointer-events: none; z-index: 3; }
  .viewer::before { top: 8px; left: 8px; border-right: 0; border-bottom: 0; }
  .viewer::after { bottom: 8px; right: 8px; border-left: 0; border-top: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; opacity: 0; transition: opacity .6s; touch-action: pan-y; }
  .ready canvas { opacity: 1; } canvas:active { cursor: grabbing; }
  .poster { position: absolute; inset: 0; display: grid; place-items: center; z-index: 1; transition: opacity .5s; }
  .poster[hidden] { display: none; }
  .poster-art { width: min(86%, 520px); height: auto; animation: float 8s ease-in-out infinite; }
  .load { position: absolute; bottom: 3.2rem; left: 0; right: 0; text-align: center; margin: 0; font: 400 .78rem var(--mono); color: var(--soft); }
  @keyframes float { 50% { transform: translateY(-8px) rotate(1.5deg); } }
  .ctrl { position: absolute; top: 12px; right: 12px; z-index: 4; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }
  .ctrl button { font: 500 .72rem var(--mono); padding: .5em .75em; min-height: 34px; background: color-mix(in srgb, var(--bg) 80%, transparent); color: var(--ink); border: 1px solid var(--line2); cursor: pointer; border-radius: 2px; }
  .ctrl button.on { background: var(--cyan); color: var(--on-accent); border-color: var(--cyan); }
  .cap { position: absolute; bottom: 10px; left: 14px; right: 14px; z-index: 4; margin: 0; font: 400 .72rem var(--mono); color: var(--soft); pointer-events: none; }
</style>
