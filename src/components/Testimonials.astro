---
import Icon from './Icon.astro';
const { title, list = [] } = Astro.props;
---
<section class="testi section light" aria-label={title}>
  <div class="wrap-wide">
    <div class="cols">
      {list.map((t, i) => (
        <figure class="card" data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
          <div class="stars" aria-hidden="true">
            {Array.from({ length: t.stars || 5 }).map(() => <Icon name="star" size="0.95rem" />)}
          </div>
          <blockquote>{t.text}</blockquote>
          {t.author && <figcaption>— {t.author}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* the sky band: light-blue gradient ground, white cards, black type (.light keeps the card ink black) */
  .testi { background: var(--sky-grad); }
  .cols { columns: 3 300px; column-gap: clamp(1rem, 2vw, 1.6rem); }
  .card { break-inside: avoid; margin: 0 0 clamp(1rem, 2vw, 1.6rem); padding: 1.7rem 1.8rem; background: #fff; border: 0; border-radius: var(--radius); box-shadow: 0 22px 44px -26px rgb(0 30 80 / 0.5); position: relative; }
  .card::before { content: '\201C'; position: absolute; top: 0.1em; right: 0.3em; font-family: var(--display); font-size: 4.5rem; line-height: 1; color: color-mix(in srgb, var(--gold) 45%, transparent); }
  .stars { display: flex; gap: 0.15rem; color: var(--gold-deep); margin-bottom: 0.9rem; }
  blockquote { margin: 0; font-size: 0.98rem; line-height: 1.6; color: var(--ink); font-weight: 450; }
  figcaption { margin-top: 1rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); font-weight: 700; }
</style>
