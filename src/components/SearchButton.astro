---
// Opens the search palette. `compact` = header version, `wide` = footer version.
const { lang = 'en', variant = 'compact' } = Astro.props;
const label = lang === 'sk' ? 'Hľadať' : 'Search';
---
<button type="button" class={`sb ${variant}`} data-search-open aria-label={`${label} (Ctrl+K)`} aria-keyshortcuts="Control+K Meta+K">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
  <span class="lbl">{label}</span>
  <kbd data-kbd aria-hidden="true">Ctrl K</kbd>
</button>
<style>
  .sb { display: inline-flex; align-items: center; gap: .55rem; min-height: 40px; padding: 0 .6rem; background: none; border: 1px solid var(--line2); color: var(--soft); cursor: pointer; font: 400 .8rem var(--mono); border-radius: 2px; }
  .sb:hover { color: var(--ink); border-color: var(--cyan); }
  kbd { font: 500 .68rem var(--mono); border: 1px solid var(--line2); padding: .15em .4em; border-radius: 2px; color: var(--soft); white-space: nowrap; }
  .wide { width: 100%; max-width: 20rem; min-height: 44px; } .wide .lbl { flex: 1; text-align: left; }
  /* header: icon only on small screens, hint on touch devices is pointless */
  .compact .lbl { display: none; }
  @media (max-width: 1060px) { .compact kbd { display: none; } .compact { width: 40px; justify-content: center; padding: 0; } }
  @media (hover: none) { kbd { display: none; } }
</style>
