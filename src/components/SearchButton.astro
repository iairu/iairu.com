---
// Opens the search palette. `compact` = header version, `wide` = footer version.
const { lang = 'en', variant = 'compact' } = Astro.props;
const label = lang === 'sk' ? 'Hľadať' : 'Search';
---
<button type="button" class={`sb ${variant}`} data-search-open aria-label={`${label} (Ctrl+K)`} aria-keyshortcuts="Control+K Meta+K">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
  <span class="lbl">{label}</span>
  <kbd data-kbd aria-hidden="true">Ctrl K</kbd>
</button>
<style>
  /* a real field: a recessed well, the label standing in as placeholder text, the shortcut on keycaps */
  .sb { display: inline-flex; align-items: center; gap: .6rem; min-height: 40px; padding: 0 .45rem 0 .7rem; background: var(--bg3); border: 1px solid var(--line); color: var(--soft); cursor: pointer; font: 400 .9rem var(--font); border-radius: 2px;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / .25); transition: border-color .15s, color .15s, background-color .15s; }
  .sb:hover { border-color: var(--blue); color: var(--ink); background: color-mix(in srgb, var(--bg3) 80%, var(--bg)); }
  svg { color: var(--blue); flex: none; }
  .lbl { flex: 1; text-align: left; }
  kbd { margin-left: auto; font: 500 .66rem var(--mono); padding: .2em .45em .15em; background: var(--bg2); border: 1px solid var(--line2); border-bottom-width: 2px; border-radius: 2px; color: var(--soft); white-space: nowrap; }
  .wide { width: 100%; max-width: 20rem; min-height: 44px; }
  .compact { min-width: 13rem; }
  /* header row 1: prominent, centered search bar */
  .bar { flex: 1; max-width: 34rem; margin: 0 auto; min-height: 42px; }
  /* header: icon only on small screens, hint on touch devices is pointless */
  @media (max-width: 1060px) { .compact { min-width: 0; width: 40px; justify-content: center; padding: 0; } .compact .lbl, .compact kbd { display: none; } }
  @media (max-width: 640px) { .bar .lbl, .bar kbd { display: none; } .bar { max-width: 42px; justify-content: center; padding: 0; } }
  @media (hover: none) { kbd { display: none; } }
</style>
