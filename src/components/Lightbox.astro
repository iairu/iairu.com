---
// Image modal. Mark an <img> (or an <a href="full-size"> wrapping one) with data-zoom; images inside
// .prose are picked up automatically. Zoomables sharing a [data-zoom-group] ancestor become one
// gallery: arrows, keyboard and swipe move between them. Without JS the links still open the file.
const { lang = 'en' } = Astro.props;
const L = lang === 'sk'
  ? { close: 'Zavrieť', prev: 'Predchádzajúci obrázok', next: 'Ďalší obrázok', loading: 'Načítavam…', open: 'Obrázok v plnej veľkosti', full: 'Otvoriť originál ↗' }
  : { close: 'Close', prev: 'Previous image', next: 'Next image', loading: 'Loading…', open: 'Full-size image', full: 'Open original ↗' };
---
<dialog class="lb" id="lightbox" aria-label={L.open} data-loading={L.loading}>
  <div class="stage">
    <img alt="" decoding="async" draggable="false" />
    <p class="wait" role="status">{L.loading}</p>
  </div>
  <button type="button" class="b close" data-lb-close aria-label={L.close}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <button type="button" class="b prev" data-lb-prev aria-label={L.prev}><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
  <button type="button" class="b next" data-lb-next aria-label={L.next}><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
  <div class="bar"><p class="cap" id="lb-cap"></p><span class="n" aria-hidden="true"></span><a class="orig" target="_blank" rel="noopener">{L.full}</a></div>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('.stage img')!;
    const wait = dlg.querySelector<HTMLElement>('.wait')!;
    const cap = dlg.querySelector<HTMLElement>('.cap')!;
    const count = dlg.querySelector<HTMLElement>('.n')!;
    const orig = dlg.querySelector<HTMLAnchorElement>('.orig')!;
    const prev = dlg.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dlg.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const SEL = '[data-zoom], .prose img';
    let set: HTMLElement[] = [], at = 0, opener: HTMLElement | null = null, pushed = false;

    // the <img> inside a trigger, and the URL of the full-size file
    const imgOf = (el: HTMLElement) => (el instanceof HTMLImageElement ? el : el.querySelector('img'));
    const fullOf = (el: HTMLElement) => {
      const a = el.closest('a');
      return el.dataset.full || (a && /\.(jpe?g|png|webp|gif|avif|svg)(\?|$)/i.test(a.href) ? a.href : '') || imgOf(el)?.currentSrc || (imgOf(el) as HTMLImageElement).src;
    };

    function show(n: number) {
      at = (n + set.length) % set.length;
      const el = set[at], thumb = imgOf(el)!, src = fullOf(el);
      dlg!.classList.add('busy');
      img.alt = thumb.alt;
      img.src = src;
      if (img.complete && img.naturalWidth) dlg!.classList.remove('busy');
      cap.textContent = thumb.alt;
      orig.href = src;
      count.textContent = set.length > 1 ? `${at + 1} / ${set.length}` : '';
      dlg!.classList.toggle('single', set.length < 2);
      prev.hidden = next.hidden = set.length < 2;
      for (const d of [1, -1]) if (set.length > 1) new Image().src = fullOf(set[(at + d + set.length) % set.length]);
    }
    img.addEventListener('load', () => dlg!.classList.remove('busy'));
    img.addEventListener('error', () => dlg!.classList.remove('busy'));

    function open(el: HTMLElement) {
      const group = el.closest<HTMLElement>('[data-zoom-group]') ?? document;
      set = [...group.querySelectorAll<HTMLElement>(SEL)].filter((x) => imgOf(x));
      opener = el;
      document.documentElement.classList.add('modal-open');
      dlg!.showModal();
      show(Math.max(0, set.indexOf(el)));
      // let the phone's Back button close the modal instead of leaving the page
      history.pushState({ lb: 1 }, ''); pushed = true;
    }
    function close() { if (dlg!.open) dlg!.close(); }
    dlg.addEventListener('close', () => {
      document.documentElement.classList.remove('modal-open'); img.removeAttribute('src');
      if (pushed) { pushed = false; if (history.state?.lb) history.back(); }
      opener?.focus?.({ preventScroll: true });
    });
    window.addEventListener('popstate', () => { if (dlg!.open) { pushed = false; close(); } });

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const t = (e.target as HTMLElement).closest<HTMLElement>(SEL);
      if (!t || !imgOf(t)) return;
      e.preventDefault(); open(t);
    });
    // make zoomable images reachable by keyboard
    document.querySelectorAll<HTMLElement>('.prose img, img[data-zoom]').forEach((i) => {
      if (i.closest('a')) return;
      i.tabIndex = 0; i.setAttribute('role', 'button'); i.style.cursor = 'zoom-in';
      i.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); } });
    });

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dlg.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === dlg || t.classList.contains('stage')) close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1); else if (e.key === 'ArrowRight') show(at + 1);
    });

    // swipe between images (ignored while the page is pinch-zoomed or with two fingers down)
    let sx = 0, sy = 0, fingers = 0, moved = false;
    const st = dlg.querySelector<HTMLElement>('.stage')!;
    st.addEventListener('touchstart', (e) => { fingers = e.touches.length; if (fingers === 1) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; moved = false; } }, { passive: true });
    st.addEventListener('touchmove', () => { moved = true; }, { passive: true });
    st.addEventListener('touchend', (e) => {
      if (fingers !== 1 || !moved || set.length < 2 || (window.visualViewport?.scale ?? 1) > 1.05) return;
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
      else if (dy > 90 && Math.abs(dy) > Math.abs(dx) * 1.5) close(); // pull down to dismiss
    }, { passive: true });
  }
</script>

<style>
  .lb { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(3 6 9 / .94); color: #e9eff3; overflow: hidden; }
  .lb[open] { display: block; animation: fade .18s ease-out; }
  .lb::backdrop { background: #000; }
  @keyframes fade { from { opacity: 0; } }
  .stage { position: absolute; inset: 0; display: grid; place-items: center; padding: calc(56px + env(safe-area-inset-top)) max(8px, env(safe-area-inset-right)) calc(64px + env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left)); touch-action: pan-x pan-y pinch-zoom; }
  .stage img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; background: rgb(255 255 255 / .03); transition: opacity .15s; }
  .busy .stage img { opacity: .25; }
  .wait { position: absolute; margin: 0; font: 400 .8rem var(--mono); color: #9fb1bd; opacity: 0; pointer-events: none; }
  .busy .wait { opacity: 1; }
  .b { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; background: rgb(15 23 31 / .78); color: #e9eff3; border: 1px solid rgb(255 255 255 / .22); border-radius: 2px; cursor: pointer; z-index: 2; -webkit-tap-highlight-color: transparent; }
  .b:hover { border-color: var(--cyan); color: var(--cyan); }
  .b[hidden] { display: none; }
  .close { top: calc(8px + env(safe-area-inset-top)); right: max(8px, env(safe-area-inset-right)); }
  .prev, .next { top: 50%; transform: translateY(-50%); }
  .prev { left: max(8px, env(safe-area-inset-left)); } .next { right: max(8px, env(safe-area-inset-right)); }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 1rem; padding: .7rem max(1rem, env(safe-area-inset-right)) calc(.7rem + env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left)); background: linear-gradient(0deg, rgb(3 6 9 / .92), transparent); font: 400 .8rem/1.4 var(--mono); }
  .cap { flex: 1; margin: 0; min-width: 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: #d3dde4; }
  .n { color: #9fb1bd; white-space: nowrap; }
  .orig { color: var(--cyan); white-space: nowrap; padding: .6rem 0; }
  @media (max-width: 640px) {
    /* thumbs-reach layout: arrows move to the lower corners, swipe is the main gesture */
    .prev, .next { top: auto; bottom: calc(60px + env(safe-area-inset-bottom)); transform: none; width: 44px; height: 44px; opacity: .85; }
    .stage { padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
    .single .stage { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    .bar { flex-wrap: wrap; gap: .2rem 1rem; }
    .cap { flex-basis: 100%; }
    .orig { margin-left: auto; }
  }
  @media (max-height: 480px) and (orientation: landscape) {
    .stage { padding: 8px 64px; } .single .stage { padding: 8px 8px; }
    .bar { background: none; pointer-events: none; padding-bottom: .3rem; } .cap, .orig { display: none; }
    .prev, .next { top: 50%; bottom: auto; transform: translateY(-50%); }
  }
</style>
