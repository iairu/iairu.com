---
// Site-wide search palette (Ctrl+K, Cmd+K on macOS). The index is a static JSON per language,
// fetched the first time the palette opens. Any element with [data-search-open] opens it and any
// [data-kbd] element gets the shortcut hint for the visitor's platform.
const { lang = 'en' } = Astro.props;
const L = lang === 'sk'
  ? { title: 'Hľadať na webe', ph: 'Hľadať projekty, dokumenty, stránky…', close: 'Zavrieť', none: 'Nič sa nenašlo pre', hint: 'Skús iné slovo alebo časť názvu.', nav: 'šípky vyberajú', go: 'Enter otvorí', esc: 'Esc zavrie', err: 'Index sa nepodarilo načítať.', recent: 'Rýchle odkazy' }
  : { title: 'Search the site', ph: 'Search projects, docs, pages…', close: 'Close', none: 'Nothing found for', hint: 'Try another word or part of a title.', nav: 'arrows to select', go: 'Enter to open', esc: 'Esc to close', err: 'Could not load the index.', recent: 'Quick links' };
---
<dialog class="srch" id="search" aria-label={L.title} data-index={`/${lang}/search.json`} data-none={L.none} data-hint={L.hint} data-err={L.err} data-recent={L.recent}>
  <form method="dialog" class="box" role="search" onsubmit="return false">
    <div class="row">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      <input type="search" id="search-q" placeholder={L.ph} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" role="combobox" aria-expanded="true" aria-controls="search-list" aria-label={L.title} />
      <button type="button" class="x" data-search-close aria-label={L.close}>
        <span class="esc" aria-hidden="true">esc</span>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="status sr-only" role="status" aria-live="polite"></p>
    <ul id="search-list" role="listbox" aria-label={L.title}></ul>
    <p class="keys" aria-hidden="true"><span>↑↓ {L.nav}</span><span>↵ {L.go}</span><span>{L.esc}</span></p>
  </form>
</dialog>

<script>
  const dlg = document.getElementById('search') as HTMLDialogElement | null;
  const mac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
  document.querySelectorAll('[data-kbd]').forEach((k) => { k.textContent = mac ? '⌘K' : 'Ctrl K'; });

  if (dlg) {
    type Kind = 'page' | 'project' | 'doc';
    type Raw = { t: string; kt: Kind; k: string; u: string; d?: string; s?: string; b?: string };
    // A folded string carries its NFD source and a map from folded index -> NFD index, so a match
    // found in the accent-insensitive text can be highlighted on the real characters.
    type Folded = { f: string; d: string; map: number[] };
    type Item = Raw & { ext: boolean; _t: Folded; _m: string; _b: Folded | null };

    const MAX = 40, QUICK = 8;
    const q = dlg.querySelector<HTMLInputElement>('#search-q')!;
    const list = dlg.querySelector<HTMLUListElement>('#search-list')!;
    const status = dlg.querySelector<HTMLElement>('.status')!;
    let items: Item[] | null = null, shown: Item[] = [], active = 0, opener: HTMLElement | null = null;

    // Fold to lowercase, accent-stripped text while remembering where each kept character
    // came from in the NFD source (used to map matches back for highlighting).
    function fold(src: string): Folded {
      const d = src.normalize('NFD');
      let f = ''; const map: number[] = [];
      for (let i = 0; i < d.length; i++) {
        const c = d[i];
        if (c >= '̀' && c <= 'ͯ') continue; // combining mark
        f += c.toLowerCase(); map.push(i);
      }
      return { f, d, map };
    }

    const ICONS: Record<Kind, string> = {
      page: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/>',
      project: '<path d="M9 8 5 12l4 4"/><path d="m15 8 4 4-4 4"/>',
      doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 16h6M9 10h3"/>',
    };
    const icon = (kt: Kind) => {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 24 24'); svg.setAttribute('width', '17'); svg.setAttribute('height', '17');
      svg.setAttribute('fill', 'none'); svg.setAttribute('stroke', 'currentColor'); svg.setAttribute('stroke-width', '1.8');
      svg.setAttribute('stroke-linecap', 'round'); svg.setAttribute('stroke-linejoin', 'round'); svg.setAttribute('aria-hidden', 'true');
      svg.innerHTML = ICONS[kt]; svg.classList.add(`i-${kt}`);
      return svg;
    };

    async function load() {
      if (items) return;
      try {
        const r = await fetch(dlg!.dataset.index!);
        items = (await r.json() as Raw[]).map((i) => ({
          ...i, ext: /^https?:/.test(i.u),
          _t: fold(i.t), _m: fold(`${i.d ?? ''} ${i.s ?? ''}`).f, _b: i.b ? fold(i.b) : null,
        }));
      } catch { items = []; status.textContent = dlg!.dataset.err!; }
    }

    // One word scored against one item: title beats metadata beats body; a word that lands nowhere
    // rejects the item (every word must match somewhere). A long word tolerates a single typo in the title.
    function wordScore(it: Item, w: string): number {
      const t = it._t.f, i = t.indexOf(w);
      if (t === w) return 110;
      if (t.startsWith(w)) return 64;
      if (i > 0 && /[^a-z0-9]/.test(t[i - 1])) return 48;
      if (i !== -1) return 32;
      if (it._m.includes(w)) return 16;
      if (it._b && it._b.f.includes(w)) return 9;
      if (w.length >= 4 && fuzzyTitle(t, w)) return 11;
      return 0;
    }
    function score(it: Item, words: string[]): number {
      let total = 0, inTitle = 0;
      for (const w of words) {
        const s = wordScore(it, w); if (!s) return 0;
        total += s; if (s >= 32) inTitle++;
      }
      if (inTitle === words.length && words.length > 1) total += 24; // all terms in the title
      return total;
    }
    const near = (a: string, b: string) => { // true if a and b differ by at most one edit
      if (a === b) return true;
      if (Math.abs(a.length - b.length) > 1) return false;
      let i = 0, j = 0, edits = 0;
      while (i < a.length && j < b.length) {
        if (a[i] === b[j]) { i++; j++; continue; }
        if (++edits > 1) return false;
        if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; }
      }
      return edits + (a.length - i) + (b.length - j) <= 1;
    };
    const fuzzyTitle = (t: string, w: string) => t.split(/[^a-z0-9]+/).some((p) => p.length >= 3 && near(p, w));

    // Build the matching ranges of `words` inside a folded string.
    function ranges(f: string, words: string[]): [number, number][] {
      const hits: [number, number][] = [];
      for (const w of words) { let i = 0; while ((i = f.indexOf(w, i)) !== -1) { hits.push([i, i + w.length]); i += w.length; } }
      hits.sort((a, b) => a[0] - b[0]);
      const out: [number, number][] = [];
      for (const [s, e] of hits) { const last = out[out.length - 1]; if (last && s <= last[1]) last[1] = Math.max(last[1], e); else out.push([s, e]); }
      return out;
    }
    // Highlight `words` inside a piece of display text, marking the real (accented) characters.
    function highlight(text: string, words: string[]): DocumentFragment {
      const { f, d, map } = fold(text);
      const frag = document.createDocumentFragment();
      const at = (fi: number) => (fi < map.length ? map[fi] : d.length);
      let pos = 0;
      for (const [a, b] of ranges(f, words)) {
        const s = at(a), e = at(b);
        if (s > pos) frag.append(d.slice(pos, s));
        const m = document.createElement('mark'); m.textContent = d.slice(s, e); frag.append(m); pos = e;
      }
      if (pos < d.length) frag.append(d.slice(pos));
      return frag;
    }
    // A short body excerpt centred on the first matched word, or null if nothing matches the body.
    function snippet(it: Item, words: string[]): DocumentFragment | null {
      const bf = it._b; if (!bf) return null;
      let hit = -1;
      for (const w of words) { const i = bf.f.indexOf(w); if (i !== -1 && (hit === -1 || i < hit)) hit = i; }
      if (hit === -1) return null;
      let a = Math.max(0, hit - 44);
      if (a > 0) { const sp = bf.f.indexOf(' ', a); if (sp !== -1 && sp < hit) a = sp + 1; }
      let b = Math.min(bf.f.length, a + 170);
      if (b < bf.f.length) { const sp = bf.f.lastIndexOf(' ', b); if (sp > hit) b = sp; }
      const at = (fi: number) => (fi < bf.map.length ? bf.map[fi] : bf.d.length);
      let text = bf.d.slice(at(a), at(b));
      if (a > 0) text = '… ' + text;
      if (b < bf.f.length) text += ' …';
      return highlight(text, words);
    }

    function paint() {
      const words = fold(q.value.trim()).f.split(/\s+/).filter(Boolean);
      const scored = !items ? [] : words.length
        ? items.map((i) => [i, score(i, words)] as const).filter(([, s]) => s > 0)
            .sort((x, y) => y[1] - x[1] || x[0]._t.f.length - y[0]._t.f.length).slice(0, MAX)
        : items.slice(0, QUICK).map((i) => [i, 0] as const);

      // With a query, group by kind (strongest-hitting group first). Empty query shows one flat
      // "Quick links" group so the starter list isn't split by type.
      const order: { label: string; kt: Kind | null; arr: Item[] }[] = [];
      if (words.length) {
        const groups = new Map<Kind, { label: string; best: number; arr: Item[] }>();
        for (const [i, s] of scored) {
          const g = groups.get(i.kt) ?? { label: i.k, best: -1, arr: [] };
          g.best = Math.max(g.best, s); g.arr.push(i); groups.set(i.kt, g);
        }
        for (const [kt, g] of [...groups.entries()].sort((x, y) => y[1].best - x[1].best)) order.push({ label: g.label, kt, arr: g.arr });
      } else if (scored.length) {
        order.push({ label: dlg!.dataset.recent!, kt: null, arr: scored.map(([i]) => i) });
      }

      shown = []; active = 0;
      const frag = document.createDocumentFragment();
      for (const g of order) {
        const h = document.createElement('li'); h.className = 'grp'; h.setAttribute('role', 'presentation');
        const t = document.createElement('span'); t.textContent = g.label;
        const c = document.createElement('span'); c.className = 'c'; c.textContent = String(g.arr.length);
        h.append(t, c); frag.append(h);
        for (const it of g.arr) frag.append(renderItem(it, shown.push(it) - 1, words, g.kt ?? it.kt));
      }
      if (words.length && !shown.length) {
        const li = document.createElement('li'); li.className = 'none';
        const p = document.createElement('p');
        p.textContent = `${dlg!.dataset.none} “${q.value.trim()}”. ${dlg!.dataset.hint}`;
        li.append(p); frag.append(li);
      }
      list.replaceChildren(frag);
      status.textContent = words.length ? `${shown.length}` : '';
      list.dataset.empty = String(!words.length);
      select(0, false);
    }

    function renderItem(it: Item, n: number, words: string[], kt: Kind) {
      const li = document.createElement('li'); li.id = `sr-${n}`; li.className = 'opt'; li.setAttribute('role', 'option');
      const a = document.createElement('a'); a.href = it.u; a.tabIndex = -1;
      if (it.ext) { a.rel = 'noopener'; a.target = '_blank'; }
      const b = document.createElement('span'); b.className = 'b';
      const h = document.createElement('b');
      h.append(words.length ? highlight(it.t, words) : document.createTextNode(it.t)); b.append(h);
      if (it.d) { const d = document.createElement('small'); d.className = 'sub'; d.append(words.length ? highlight(it.d, words) : document.createTextNode(it.d)); b.append(d); }
      const titleHasAll = words.length > 0 && words.every((w) => it._t.f.includes(w));
      const snip = !titleHasAll && words.length ? snippet(it, words) : null;
      if (snip) { const p = document.createElement('small'); p.className = 'snip'; p.append(snip); b.append(p); }
      a.append(icon(kt), b);
      if (it.ext) {
        const e = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        e.setAttribute('viewBox', '0 0 24 24'); e.setAttribute('width', '14'); e.setAttribute('height', '14'); e.classList.add('ext');
        e.setAttribute('fill', 'none'); e.setAttribute('stroke', 'currentColor'); e.setAttribute('stroke-width', '2'); e.setAttribute('stroke-linecap', 'round'); e.setAttribute('aria-hidden', 'true');
        e.innerHTML = '<path d="M7 17 17 7M9 7h8v8"/>'; a.append(e);
      }
      li.append(a);
      li.addEventListener('mousemove', () => select(n, false));
      return li;
    }

    function select(n: number, scroll = true) {
      if (!shown.length) { q.removeAttribute('aria-activedescendant'); return; }
      active = (n + shown.length) % shown.length;
      list.querySelectorAll('[role=option]').forEach((li, idx) => li.setAttribute('aria-selected', String(idx === active)));
      q.setAttribute('aria-activedescendant', `sr-${active}`);
      if (scroll) list.querySelector(`#sr-${active}`)?.scrollIntoView({ block: 'nearest' });
    }

    async function open(from?: HTMLElement | null) {
      if (dlg!.open) return;
      opener = from ?? (document.activeElement as HTMLElement | null);
      document.documentElement.classList.add('modal-open');
      dlg!.showModal();
      q.focus();
      await load(); paint();
    }
    const close = () => dlg!.close();
    dlg.addEventListener('close', () => { document.documentElement.classList.remove('modal-open'); q.value = ''; opener?.focus?.(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }); // backdrop
    dlg.querySelector('[data-search-close]')!.addEventListener('click', close);
    list.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close(); });
    q.addEventListener('input', paint);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
      else if (e.key === 'Home' && !e.shiftKey) { e.preventDefault(); select(0); }
      else if (e.key === 'End' && !e.shiftKey) { e.preventDefault(); select(shown.length - 1); }
      else if (e.key === 'Enter') {
        const i = shown[active]; if (!i) return; e.preventDefault();
        if (i.ext) window.open(i.u, '_blank', 'noopener'); else { close(); location.href = i.u; }
      }
    });
    document.querySelectorAll<HTMLElement>('[data-search-open]').forEach((b) => b.addEventListener('click', () => open(b)));
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? close() : open(); }
    });
  }
</script>

<!-- Global (not scoped) so the rules reach the result nodes the script builds with createElement,
     which never carry Astro's data-astro-cid attribute. Every selector is pinned under #search. -->
<style is:global>
  #search { padding: 0; border: 1px solid var(--line2); background: var(--bg); color: var(--ink); width: min(640px, calc(100% - 2rem)); max-width: none; max-height: min(70dvh, 560px); margin: 12dvh auto auto; box-shadow: var(--shadow), 0 0 0 1px rgb(0 0 0 / .2); overflow: hidden; }
  #search[open] { display: flex; flex-direction: column; animation: srch-pop .16s ease-out; }
  #search::backdrop { background: rgb(4 8 12 / .62); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  @keyframes srch-pop { from { opacity: 0; transform: translateY(-8px); } }
  #search .box { display: flex; flex-direction: column; min-height: 0; flex: 1; margin: 0; }
  #search .row { display: flex; align-items: center; gap: .7rem; padding: 0 .4rem 0 1rem; border-bottom: 1px solid var(--line); color: var(--blue); background: var(--bg3); box-shadow: inset 0 1px 2px rgb(0 0 0 / .25); }
  #search input { flex: 1; min-width: 0; height: 56px; background: none; border: 0; color: var(--ink); font: 400 1.05rem var(--font); outline: none; -webkit-appearance: none; appearance: none; }
  #search input::-webkit-search-cancel-button { display: none; }
  #search input::placeholder { color: var(--soft); opacity: .8; }
  #search .row:focus-within { border-bottom-color: var(--blue); }
  #search .x { display: inline-flex; align-items: center; gap: .5rem; min-width: 44px; height: 44px; justify-content: center; background: none; border: 0; color: var(--soft); cursor: pointer; font: 500 .7rem var(--mono); }
  #search .x:hover { color: var(--ink); }
  #search .esc { border: 1px solid var(--line2); padding: .2em .45em; border-radius: 2px; }
  #search ul { list-style: none; margin: 0; padding: .3rem .4rem .4rem; overflow-y: auto; overscroll-behavior: contain; flex: 1; min-height: 0; scrollbar-width: thin; }
  /* group header: a quiet divider that names the result type and counts it */
  #search .grp { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; position: sticky; top: 0; z-index: 1;
    margin-top: .25rem; padding: .7rem .7rem .35rem; background: linear-gradient(var(--bg) 68%, transparent); font: 500 .66rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); }
  #search .grp:first-child { margin-top: 0; }
  #search .grp .c { color: var(--line2); font-size: .64rem; }
  #search .opt a { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: .75rem; align-items: start; padding: .5rem .7rem; text-decoration: none; color: var(--ink); border-radius: 3px; }
  #search .opt a > svg:first-child { margin-top: .2rem; color: var(--soft); }
  #search .i-project { color: var(--cobalt); } #search .i-doc { color: var(--teal); } #search .i-page { color: var(--blue); }
  #search .opt .ext { align-self: center; color: var(--line2); }
  #search .opt[aria-selected='true'] a { background: var(--bg3); }
  #search .opt[aria-selected='true'] a > svg:first-child, #search .opt[aria-selected='true'] .b b { color: var(--blue); }
  #search .opt[aria-selected='true'] .ext { color: var(--soft); }
  #search .b { display: grid; min-width: 0; gap: .08rem; }
  #search .b b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #search .b .sub { color: var(--soft); font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #search .b .snip { color: var(--soft); font-size: .8rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: .12rem; }
  #search mark { background: color-mix(in srgb, var(--blue) 28%, transparent); color: inherit; border-radius: 2px; padding: 0 .08em; }
  #search .b .snip mark { background: color-mix(in srgb, var(--blue) 20%, transparent); }
  #search .opt[aria-selected='true'] mark { background: color-mix(in srgb, var(--blue) 42%, transparent); }
  #search .none { padding: 1.4rem 1rem; color: var(--soft); } #search .none p { margin: 0; }
  #search .keys { display: flex; gap: 1.2rem; margin: 0; padding: .55rem 1rem; border-top: 1px solid var(--line); font: 400 .68rem var(--mono); color: var(--soft); }
  @media (hover: none), (max-width: 640px) { #search .keys { display: none; } #search .esc { display: none; } }
  @media (max-width: 640px) {
    #search { width: 100%; max-height: none; height: 100dvh; margin: 0; border: 0; }
    #search input { font-size: 16px; } /* 16px stops iOS from zooming the page on focus */
    #search ul { padding-bottom: calc(.4rem + env(safe-area-inset-bottom)); }
    #search .opt a { padding: .7rem; }
  }
</style>
