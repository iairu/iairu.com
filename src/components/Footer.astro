---
import { ui } from '../data/i18n.js';
import { nav, person, links } from '../data/site.js';
import { lhref, tr } from '../data/util.js';
import { repoSnapshotDate } from '../data/projects.js';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SearchButton from './SearchButton.astro';
const { lang } = Astro.props;
const T = ui[lang];
const F = T.footer;
const year = new Date().getFullYear();
const quick = [
  ['projects/', lang === 'sk' ? 'Všetky projekty' : 'All projects'],
  ['projects/#filters', lang === 'sk' ? 'Filtre a hľadanie' : 'Filters & search'],
  ['art/', T.nav.art],
  ['docs/', T.nav.docs],
];
---
<footer class="ftr" id="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={lhref(lang)} aria-label={`iairu, ${T.nav.home}`}><Logo height={30} /></a>
        <p class="who">{person.full}</p>
        <p class="role">{tr(person.role, lang)}</p>
        <p class="small">{F.blurb}</p>
        <p class="search"><SearchButton lang={lang} variant="wide" /></p>
        <p class="small"><a class="mail" href={`mailto:${person.email}`}>{person.email}</a></p>
      </div>
      <nav class="map" aria-label={F.sitemap}>
        <div class="col">
          <h2>{F.sitemap}</h2>
          <ul>
            <li><a href={lhref(lang)}>{T.nav.home}</a></li>
            {nav.map((n) => <li><a href={lhref(lang, n.path)}>{T.nav[n.key]}</a></li>)}
            <li><a href={lhref(lang, 'sitemap/')}>{T.nav.sitemap}</a></li>
          </ul>
        </div>
        <div class="col">
          <h2>{F.explore}</h2>
          <ul>{quick.map(([p, l]) => <li><a href={lhref(lang, p)}>{l}</a></li>)}</ul>
        </div>
        <div class="col">
          <h2>{F.contact}</h2>
          <ul>
            <li><a href={`mailto:${person.email}`}>E-mail</a></li>
            <li><a href={links.github} rel="me noopener">GitHub <Icon name="ext" /></a></li>
            <li><a href={links.linkedin} rel="me noopener">LinkedIn <Icon name="ext" /></a></li>
            <li><a href={lhref(lang, 'contact/')}>{T.nav.contact}</a></li>
          </ul>
        </div>
        <div class="col">
          <h2>{F.elsewhere}</h2>
          <ul>
            <li><a href={links.nightjar} rel="noopener">NightJar.Gift <Icon name="ext" /></a></li>
            <li><a href={links.nightjarDocs} rel="noopener">KNIFES docs <Icon name="ext" /></a></li>
            <li><a href="/dl/resume-en.pdf">CV (EN, PDF)</a></li>
            <li><a href="/dl/resume-sk.pdf">CV (SK, PDF)</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="bottom">
      <p>© 2016–{year} {person.name}. {F.rights}</p>
      <p>{F.repoSnap}: {repoSnapshotDate} · <a href="#top">{F.top} <Icon name="up" /></a></p>
    </div>
  </div>
</footer>
<style>
  /* the footer sits on the page itself under one hairline, so it never competes with the content above */
  .ftr { border-top: 1px solid var(--line); padding: clamp(1.8rem, 3.5vw, 2.6rem) 0 1.2rem; margin-top: clamp(2.5rem, 5vw, 4.5rem); font-size: .9rem; position: relative; }
  .ftr :global(.vortex) { animation-play-state: paused; }
  .top { display: grid; gap: 1.6rem; grid-template-columns: minmax(220px, 1fr) 3fr; }
  .brand { display: inline-block; color: var(--ink); text-decoration: none; }
  .search { margin: 1.2rem 0 1rem; }
  .who { font-size: .95rem; font-weight: 600; color: var(--ink); margin: .6rem 0 .2rem; }
  .role { color: var(--soft); font-size: .85rem; margin: 0 0 .8rem; }
  .small { color: var(--soft); max-width: 34ch; font-size: .85rem; }
  .mail { color: var(--ink); }
  .map { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.4rem 1.2rem; }
  h2 { font: 500 .9rem var(--font); color: var(--soft); margin: 0 0 .55rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .col a { color: var(--soft); text-decoration: none; } .col a:hover { color: var(--cyan); text-decoration: underline; }
  .bottom { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: .4rem 2rem; justify-content: space-between; font-size: .78rem; line-height: 1.6; color: var(--soft); }
  .bottom p { margin: 0; max-width: 70ch; } .bottom a { color: var(--soft); }
  @media (max-width: 800px) { .top { grid-template-columns: 1fr; } }
</style>
