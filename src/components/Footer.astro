---
import { ui } from '../data/i18n.js';
import { nav, person, links } from '../data/site.js';
import { lhref, tr } from '../data/util.js';
import { repoSnapshotDate } from '../data/projects.js';
const { lang } = Astro.props;
const T = ui[lang];
const F = T.footer;
const year = new Date().getFullYear();
const quick = [
  ['projects/', lang === 'sk' ? 'Všetky projekty' : 'All projects'],
  ['projects/#filters', lang === 'sk' ? 'Filtre a hľadanie' : 'Filters & search'],
  ['art/', T.nav.art],
  ['docs/', T.nav.docs],
];
---
<footer class="ftr" id="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={lhref(lang)}>iairu</a>
        <p class="who">{person.full}</p>
        <p class="small">{F.blurb}</p>
        <p class="small"><a class="mail" href={`mailto:${person.email}`}>{person.email}</a></p>
      </div>
      <nav class="map" aria-label={F.sitemap}>
        <div class="col">
          <h2>{F.sitemap}</h2>
          <ul>
            <li><a href={lhref(lang)}>{T.nav.home}</a></li>
            {nav.map((n) => <li><a href={lhref(lang, n.path)}>{T.nav[n.key]}</a></li>)}
            <li><a href={lhref(lang, 'sitemap/')}>{T.nav.sitemap}</a></li>
          </ul>
        </div>
        <div class="col">
          <h2>{F.explore}</h2>
          <ul>{quick.map(([p, l]) => <li><a href={lhref(lang, p)}>{l}</a></li>)}</ul>
        </div>
        <div class="col">
          <h2>{F.contact}</h2>
          <ul>
            <li><a href={`mailto:${person.email}`}>E-mail</a></li>
            <li><a href={links.github} rel="me noopener">GitHub ↗</a></li>
            <li><a href={links.linkedin} rel="me noopener">LinkedIn ↗</a></li>
            <li><a href={lhref(lang, 'contact/')}>{T.nav.contact}</a></li>
          </ul>
        </div>
        <div class="col">
          <h2>{F.elsewhere}</h2>
          <ul>
            <li><a href={links.nightjar} rel="noopener">NightJar.Gift ↗</a></li>
            <li><a href={links.nightjarDocs} rel="noopener">KNIFES docs ↗</a></li>
            <li><a href="/dl/resume-en.pdf">CV (EN, PDF)</a></li>
            <li><a href="/dl/resume-sk.pdf">CV (SK, PDF)</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="bottom">
      <p>© 2016–{year} {person.name}. {F.rights}</p>
      <p>{F.repoSnap}: {repoSnapshotDate} · <a href="#top">{F.top} ↑</a></p>
    </div>
  </div>
</footer>
<style>
  .ftr { background: var(--bg2); border-top: 1px solid var(--line); padding: clamp(2.5rem, 5vw, 4rem) 0 1.6rem; margin-top: clamp(3rem, 6vw, 6rem); position: relative; }
  .ftr::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 3px; background: linear-gradient(90deg, var(--cyan) 0 50%, var(--copper) 50% 100%); }
  .top { display: grid; gap: 2.5rem; grid-template-columns: minmax(220px, 1fr) 3fr; }
  .brand { font: 700 1.6rem var(--font); letter-spacing: -.03em; color: var(--ink); text-decoration: none; }
  .who { font: 500 .8rem var(--mono); color: var(--copper); margin: .2rem 0 .8rem; }
  .small { color: var(--soft); max-width: 34ch; font-size: .95rem; }
  .mail { color: var(--ink); }
  .map { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 2rem 1.5rem; }
  h2 { font: 500 .72rem var(--mono); letter-spacing: .15em; text-transform: uppercase; color: var(--copper); margin: 0 0 .9rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .col a { color: var(--ink); text-decoration: none; opacity: .85; } .col a:hover { opacity: 1; color: var(--cyan); text-decoration: underline; }
  .bottom { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: .4rem 2rem; justify-content: space-between; font: 400 .74rem/1.6 var(--mono); color: var(--soft); }
  .bottom p { margin: 0; max-width: 70ch; } .bottom a { color: var(--soft); }
  @media (max-width: 800px) { .top { grid-template-columns: 1fr; } }
</style>
