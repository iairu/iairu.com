---
import { ui, LANGS, LANG_NAMES } from '../data/i18n.js';
import { nav } from '../data/site.js';
import { lhref } from '../data/util.js';
import Logo from './Logo.astro';
import SearchButton from './SearchButton.astro';
const { lang, path = '' } = Astro.props;
const T = ui[lang];
const here = Astro.url.pathname;
const active = (p) => here.startsWith(lhref(lang, p));
---
<header class="hdr" id="top">
  <div class="wrap bar">
    <a class="brand" href={lhref(lang)} aria-label={`iairu, ${T.nav.home}`}>
      <Logo height={26} />
    </a>
    <nav id="primary-nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={lhref(lang, n.path)} aria-current={active(n.path) ? 'page' : undefined}>{T.nav[n.key]}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <SearchButton lang={lang} variant="compact" />
      <div class="langs" role="group" aria-label={T.language}>
        {LANGS.map((l) => <a href={lhref(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]}>{l.toUpperCase()}</a>)}
      </div>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label={T.theme} title={T.theme}>
        <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10Z"/></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={T.menu}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="l1" d="M4 7h16"/><path class="l2" d="M4 12h16"/><path class="l3" d="M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 90; height: var(--hdr); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--ink); text-decoration: none; margin-right: auto; padding: .4rem 0; }
  nav ul { display: flex; gap: .1rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: .5rem .85rem; color: var(--soft); text-decoration: none; font: 500 .82rem var(--mono); letter-spacing: .03em; position: relative; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page']::after { content: ''; position: absolute; left: .85rem; right: .85rem; bottom: 2px; height: 2px; background: var(--copper); }
  .tools { display: flex; align-items: center; gap: .4rem; }
  .langs { display: inline-flex; border: 1px solid var(--line2); }
  .langs a { font: 500 .72rem var(--mono); padding: .45rem .55rem; color: var(--soft); text-decoration: none; }
  .langs a[aria-current='true'] { background: var(--cyan); color: var(--on-accent); }
  .icon-btn { display: inline-grid; place-items: center; width: 40px; height: 40px; background: none; border: 1px solid transparent; color: var(--ink); cursor: pointer; border-radius: 2px; }
  .icon-btn:hover { border-color: var(--line2); }
  :global(:root[data-theme='dark']) .ic-sun, :global(:root[data-theme='light']) .ic-moon { display: none; }
  .menu-btn { display: none; }
  @media (max-width: 860px) {
    .menu-btn { display: inline-grid; }
    nav { position: fixed; inset: var(--hdr) 0 auto 0; background: var(--bg); border-bottom: 1px solid var(--line2); padding: .6rem var(--gutter) 1.2rem; display: none; }
    nav.open { display: block; }
    nav ul { flex-direction: column; }
    nav a { font-size: 1rem; padding: .9rem .2rem; border-bottom: 1px solid var(--line); }
    nav a[aria-current='page']::after { left: 0; right: auto; width: 2.4rem; bottom: -1px; }
    :global(html:not(.js)) nav { position: static; display: block; padding: 0; border: 0; }
    :global(html:not(.js)) .bar { flex-wrap: wrap; height: auto; }
    :global(html:not(.js)) .hdr { height: auto; position: static; }
    :global(html:not(.js)) nav ul { flex-direction: row; flex-wrap: wrap; }
    :global(html:not(.js)) .menu-btn { display: none; }
  }
</style>
