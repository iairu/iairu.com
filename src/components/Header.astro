---
import { ui, LANGS, LANG_NAMES } from '../data/i18n.js';
import { nav } from '../data/site.js';
import { lhref } from '../data/util.js';
import Logo from './Logo.astro';
import SearchButton from './SearchButton.astro';
const { lang, path = '' } = Astro.props;
const T = ui[lang];
const here = Astro.url.pathname;
const active = (p) => here.startsWith(lhref(lang, p));
const isHome = here === lhref(lang);
---
<header class="hdr" id="top">
  <div class="wrap bar">
    <a class="brand" href={lhref(lang)} aria-label={`iairu, ${T.nav.home}`}>
      <Logo height={26} />
    </a>
    <SearchButton lang={lang} variant="bar" />
    <div class="tools">
      <div class="langs" role="group" aria-label={T.language}>
        {LANGS.map((l) => <a href={lhref(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]}>{l.toUpperCase()}</a>)}
      </div>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label={T.theme} title={T.theme}>
        <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10Z"/></svg>
      </button>
    </div>
  </div>
</header>
<nav class="tabs" aria-label="Main">
  <div class="glass" aria-hidden="true"></div>
  <div class="tabs-scroll wrap">
    <a href={lhref(lang)} aria-current={isHome ? 'page' : undefined}>{T.nav.home}</a>
    {nav.map((n) => <a href={lhref(lang, n.path)} aria-current={active(n.path) ? 'page' : undefined}>{T.nav[n.key]}</a>)}
  </div>
</nav>
<style>
  .hdr { position: sticky; top: 0; z-index: 91; height: var(--hdr1); background: var(--bg2); border-bottom: 1px solid var(--line); }
  /* tinted glass: a real layer under the tabs blurs the page, and the blur fades out just below them */
  .glass { position: absolute; inset: 0 0 -22px 0; pointer-events: none;
    /* a faint blue wash, strongest at the top edge */
    background: linear-gradient(180deg, color-mix(in srgb, var(--blue) 14%, transparent), color-mix(in srgb, var(--blue) 3%, transparent));
    /* brightness evens out what passes under the bar: bright pictures are pulled down toward its tone, dark ones barely move */
    -webkit-backdrop-filter: blur(16px) saturate(1.3) brightness(.72); backdrop-filter: blur(16px) saturate(1.3) brightness(.72);
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 calc(var(--hdr2) - 4px), transparent 100%); mask-image: linear-gradient(180deg, #000 0, #000 calc(var(--hdr2) - 4px), transparent 100%); }
  /* on paper the same idea runs the other way: dark pictures are lifted toward the bar's light tone */
  .glass::after { content: ''; position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 70%, transparent); }
  :global(:root[data-theme='light']) .glass { background: linear-gradient(180deg, color-mix(in srgb, var(--blue) 14%, transparent), color-mix(in srgb, var(--blue) 3%, transparent)); }
  :global(:root[data-theme='light']) .glass { -webkit-backdrop-filter: blur(16px) saturate(1.2) brightness(1.39); backdrop-filter: blur(16px) saturate(1.2) brightness(1.39); }
  .bar { position: relative; display: flex; align-items: center; gap: 1rem; height: 100%; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--ink); text-decoration: none; padding: .4rem 0; flex: none; }
  .tools { display: flex; align-items: center; gap: .4rem; flex: none; }
  .langs { display: inline-flex; border: 1px solid var(--line2); }
  .langs a { font: 500 .72rem var(--mono); padding: .45rem .55rem; color: var(--soft); text-decoration: none; }
  .langs a[aria-current='true'] { background: var(--blue); color: var(--on-accent); }
  .icon-btn { display: inline-grid; place-items: center; width: 40px; height: 40px; background: none; border: 1px solid transparent; color: var(--ink); cursor: pointer; border-radius: 2px; }
  .icon-btn:hover { border-color: var(--line2); }
  :global(:root[data-theme='dark']) .ic-sun, :global(:root[data-theme='light']) .ic-moon { display: none; }

  /* row 2: sticky tab strip, the site's primary nav. Scrolls horizontally instead of collapsing into a drawer. */
  .tabs { position: sticky; top: var(--hdr1); z-index: 90; height: var(--hdr2); border-bottom: 1px solid var(--line); }
  .tabs-scroll { position: relative; display: flex; align-items: stretch; height: 100%; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; }
  .tabs-scroll::-webkit-scrollbar { display: none; }
  .tabs a { display: flex; align-items: center; flex: none; padding: 0 1rem; color: var(--soft); text-decoration: none; font: 500 .9rem var(--font); white-space: nowrap; position: relative; }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='page'] { color: var(--ink); }
  .tabs a[aria-current='page']::after { content: ''; position: absolute; left: 1rem; right: 1rem; bottom: 0; height: 2px; background: var(--cobalt); }

  @media (max-width: 640px) {
    .langs { display: none; }
  }
</style>
