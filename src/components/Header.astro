---
import { ui, LANGS, LANG_NAMES } from '../data/i18n.js';
import { nav } from '../data/site.js';
import { lhref } from '../data/util.js';
import Logo from './Logo.astro';
import SearchButton from './SearchButton.astro';
const { lang, path = '' } = Astro.props;
const T = ui[lang];
const here = Astro.url.pathname;
const active = (p) => here.startsWith(lhref(lang, p));
const isHome = here === lhref(lang);
---
<header class="hdr" id="top">
  <div class="wrap bar">
    <a class="brand" href={lhref(lang)} aria-label={`iairu, ${T.nav.home}`}>
      <Logo height={26} />
    </a>
    <SearchButton lang={lang} variant="bar" />
    <div class="tools">
      <div class="langs" role="group" aria-label={T.language}>
        {LANGS.map((l) => <a href={lhref(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={LANG_NAMES[l]}>{l.toUpperCase()}</a>)}
      </div>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label={T.theme} title={T.theme}>
        <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10Z"/></svg>
      </button>
    </div>
  </div>
</header>
<nav class="tabs" aria-label="Main">
  <div class="glass" aria-hidden="true"></div>
  <div class="tabs-scroll wrap">
    <a href={lhref(lang)} aria-current={isHome ? 'page' : undefined}>{T.nav.home}</a>
    {nav.map((n) => <a href={lhref(lang, n.path)} aria-current={active(n.path) ? 'page' : undefined}>{T.nav[n.key]}</a>)}
  </div>
</nav>
<style>
  .hdr { position: sticky; top: 0; z-index: 91; height: var(--hdr1); background: var(--bg2); border-bottom: 1px solid var(--line); }
  /* tinted glass: a real layer under the tabs blurs the page, and the blur fades out just below them */
  .glass { position: absolute; inset: 0 0 -22px 0; pointer-events: none;
