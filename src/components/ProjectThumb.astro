---
// A simple, deterministic SVG stand-in for projects that have no picture of their own.
// It draws a line-art glyph for the project's main area of interest over a faint grid,
// tinted with the project's field colour (inherited via --c), plus a small monogram and
// language label so two similar projects still read apart. No raster, no external file.
import { tr } from '../data/util.js';
const { p, lang = 'en' } = Astro.props;

const title = String(tr(p.title, lang) ?? p.id);
const initials = title.replace(/[^\p{L}\p{N}]+/gu, ' ').trim().split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const uid = `t-${p.id}`.replace(/[^a-z0-9-]/gi, '-');

// ---- glyphs (centred near 240,118 inside a 480 x 270 box) ----
const browser = () =>
  `<rect x="168" y="66" width="144" height="104" rx="6"/>` +
  `<path d="M168 92 H312"/>` +
  [0, 1, 2].map((i) => `<circle cx="${182 + i * 12}" cy="79" r="3.2" fill="currentColor" stroke="none"/>`).join('') +
  `<path d="M184 112 H296 M184 128 H274 M184 144 H290 M184 160 H246" opacity=".55"/>`;

const gear = () => {
  let t = '';
  for (let i = 0; i < 8; i++) { const a = i * Math.PI / 4, c = Math.cos(a), s = Math.sin(a); t += `<line x1="${(240 + c * 33).toFixed(1)}" y1="${(118 + s * 33).toFixed(1)}" x2="${(240 + c * 45).toFixed(1)}" y2="${(118 + s * 45).toFixed(1)}"/>`; }
  return t + `<circle cx="240" cy="118" r="33"/><circle cx="240" cy="118" r="13"/>`;
};

const circuit = () =>
  `<rect x="214" y="92" width="52" height="52" rx="4" fill="var(--bg3)"/>` +
  [0, 1, 2].map((i) => `<path d="M${222 + i * 16} 92 V78 M${222 + i * 16} 144 V158"/>`).join('') +
  `<path d="M214 104 H196 M214 132 H196 M266 104 H284 M266 132 H284"/>` +
  [[196, 104], [196, 132], [284, 104], [284, 132]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="5" fill="currentColor" stroke="none"/>`).join('');

const shapes = () => `<circle cx="222" cy="120" r="35"/><rect x="236" y="101" width="56" height="56"/><path d="M240 72 L283 150 L197 150 Z"/>`;

const mark = () => `<circle cx="240" cy="118" r="44"/><circle cx="240" cy="118" r="27"/><circle cx="240" cy="118" r="11" fill="currentColor" stroke="none"/>`;

const scatter = () =>
  `<path d="M186 68 V168 H316"/>` +
  `<path d="M192 160 L310 82" stroke-dasharray="7 8" opacity=".7"/>` +
  [[198, 150], [216, 134], [234, 140], [252, 112], [270, 120], [288, 92], [306, 100]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="4.5" fill="currentColor" stroke="none"/>`).join('');

const network = () => {
  const n = [[200, 78], [302, 90], [322, 150], [232, 170], [174, 136], [252, 120]];
  const e = [[0, 5], [1, 5], [2, 5], [3, 5], [4, 5], [0, 1], [3, 4], [1, 2]];
  return e.map(([a, b]) => `<line x1="${n[a][0]}" y1="${n[a][1]}" x2="${n[b][0]}" y2="${n[b][1]}" opacity=".45"/>`).join('') +
    n.map(([x, y], i) => i % 2 ? `<circle cx="${x}" cy="${y}" r="7" fill="var(--bg3)"/>` : `<rect x="${x - 10}" y="${y - 7}" width="20" height="14" rx="2" fill="var(--bg3)"/>`).join('');
};

const gamepad = () =>
  `<rect x="176" y="86" width="128" height="64" rx="32"/>` +
  `<path d="M207 104 V134 M192 119 H222"/>` +
  `<circle cx="276" cy="110" r="5.5" fill="currentColor" stroke="none"/><circle cx="291" cy="125" r="5.5" fill="currentColor" stroke="none"/>`;

const wave = () => {
  const hs = [26, 48, 72, 40, 90, 56, 102, 60, 82, 38, 64, 30];
  const bw = 10, gap = 6, x0 = 240 - (hs.length * bw + (hs.length - 1) * gap) / 2;
  return hs.map((h, i) => `<rect x="${x0 + i * (bw + gap)}" y="${118 - h / 2}" width="${bw}" height="${h}" rx="3" fill="currentColor" stroke="none"/>`).join('');
};

const atom = () =>
  [0, 60, 120].map((a) => `<ellipse cx="240" cy="118" rx="52" ry="20" transform="rotate(${a} 240 118)"/>`).join('') +
  `<circle cx="240" cy="118" r="7" fill="currentColor" stroke="none"/>`;

const GLYPH = { web: browser, automation: gear, maker: circuit, visual: shapes, brand: mark, data: scatter, infra: network, games: gamepad, audio: wave, learning: atom };
const glyph = (GLYPH[p.interests?.[0]] ?? atom)();

const body =
  `<defs>` +
  `<pattern id="grid-${uid}" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0 H0 V30" fill="none" stroke="currentColor" stroke-width="1" opacity=".07"/></pattern>` +
  `<radialGradient id="glow-${uid}" cx="72%" cy="36%" r="62%"><stop offset="0" stop-color="currentColor" stop-opacity=".18"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></radialGradient>` +
  `</defs>` +
  `<rect width="480" height="270" fill="url(#grid-${uid})"/>` +
  `<rect width="480" height="270" fill="url(#glow-${uid})"/>` +
  `<g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">${glyph}</g>` +
  `<text x="22" y="46" font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="24" font-weight="600" fill="currentColor" opacity=".75">${initials}</text>` +
  (p.language ? `<text x="458" y="250" text-anchor="end" font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="15" fill="currentColor" opacity=".55">${p.language}</text>` : '');
---
<svg class="thumb" viewBox="0 0 480 270" width="480" height="270" role="img" aria-label={title} preserveAspectRatio="xMidYMid slice"><Fragment set:html={body} /></svg>
<style>
  .thumb { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; color: var(--c, var(--blue)); background: var(--bg3); }
</style>
